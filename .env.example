# === Coucou Events — copy to .env and fill ===
# Never commit real .env

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Notion CRM ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Telegram (user client / GramJS) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# optional bot for admin alerts / booking
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOOKING_BOT_TOKEN=
BOOKING_CHAT_ID=

# --- Agent HTTP (localhost) ---
AGENT_HTTP_PORT=3001
AGENT_HTTP_SECRET=change-me-long-random

# --- Email (Brevo) ---
BREVO_API_KEY=
INBOUND_WEBHOOK_SECRET=
# ENABLE_EMAIL=1

# --- WhatsApp (optional) ---
# ENABLE_WHATSAPP=1
WA_SESSION_PATH=./data/wa-auth
CHROME_PATH=

# --- Limits (optional) ---
LIMIT_GROQ_TOKENS=2000000
LIMIT_WHISPER_SECONDS=28800
LIMIT_BREVO_EMAILS=300
MANAGER_ACTIVE_WINDOW_MS=3600000

# --- Site (public) ---
PUBLIC_SITE_URL=https://example.com
