const bookingHref = `/${lang}/booking`;
---

<section id="portfolio" class="portfolio-section" lang={lang}>
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t.sectionTag}</span>
      <h2 class="font-serif">{t.heading}</h2>
      <p class="subtitle font-light">{t.subtitle}</p>
    </div>

    <div class="portfolio-swiper-wrap">
      <!-- Навигация над кейсами, по центру: стрелка • точки • стрелка -->
      <div class="portfolio-nav">
        <button
          class="portfolio-nav-btn portfolio-nav-prev"
          type="button"
          aria-label="Предыдущий кейс"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="portfolio-pagination"></div>

        <button
          class="portfolio-nav-btn portfolio-nav-next"
          type="button"
          aria-label="Следующий кейс"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <Swiper
        options={{
          slidesPerView: 1,
          spaceBetween: 24,
          allowTouchMove: true,
          navigation: {
            prevEl: '.portfolio-nav-prev',
            nextEl: '.portfolio-nav-next',
          },
          pagination: {
            el: '.portfolio-pagination',
            clickable: true,
          },
          loop: false,
          grabCursor: false,
          breakpoints: {
            0: { allowTouchMove: true },
            901: { allowTouchMove: false },
          },
        }}
      >
        <SwiperWrapper>
          {
            t.items.map((item) => (
              <SwiperSlide>
                <article
                  class="case-card"
                  role="button"
                  tabindex="0"
                  data-title={item.title}
                  data-category={item.category}
                  data-location={item.location}
                  data-guests={item.guests}
                  data-budget={item.budget}
                  data-description={item.description}
                  data-review={item.review}
                  data-client={item.client}
                  data-image={item.images[0]}
                >
                  <div class="case-gallery" data-count={item.images.length}>
                    {item.images.map((img, idx) => (
                      <div class="case-image">
                        <img
                          src={img}
                          alt={`${item.title} — фото ${idx + 1}`}
                          loading="lazy"
                        />
                        <span class="photo-counter">
                          {idx + 1} / {item.images.length}
                        </span>
                      </div>
                    ))}
                  </div>

                  <div class="case-info">
                    <div class="case-top">
                      <span class="card-category">{item.category}</span>
                      <span class="card-location">📍 {item.location}</span>
                    </div>

                    <h3 class="font-serif">{item.title}</h3>

                    <p class="case-description">{item.description}</p>

                    <div class="case-meta">
                      <span>👥 {item.guests}</span>
                      <span>💎 {item.budget}</span>
                    </div>

                    <div class="case-cta">
                      <span>Подробнее</span>
                      <span class="case-arrow">→</span>
                    </div>
                  </div>
                </article>
              </SwiperSlide>
            ))
          }
        </SwiperWrapper>
      </Swiper>
    </div>
  </div>
</section>

<div class="portfolio-modal-overlay" id="portfolio-modal" aria-hidden="true">
  <div class="portfolio-modal-content" role="dialog" aria-modal="true">
    <button
      class="modal-close"
      id="close-portfolio-modal"
      type="button"
      aria-label="Close"
    >
      &times;
    </button>

    <div class="modal-image-wrapper">
      <img id="modal-image" src="" alt="" />
      <span class="modal-tag" id="modal-category">Категория</span>
    </div>

    <div class="modal-body">
      <h2 id="modal-title" class="font-serif">Название проекта</h2>
      <p class="modal-location" id="modal-location">Локация</p>

      <div class="modal-info-grid">
        <div>
          <span>{t.modalGuests}</span>
          <strong id="modal-guests">-</strong>
        </div>
        <div>
          <span>{t.modalBudget}</span>
          <strong id="modal-budget">-</strong>
        </div>
      </div>

      <div class="modal-section">
        <h4>{t.modalAbout}</h4>
        <p id="modal-description">Описание...</p>
      </div>

      <div class="modal-review-box">
        <h4>{t.modalReviewTitle}</h4>
        <p id="modal-review">«Отзыв»</p>
        <span class="modal-client" id="modal-client">Имя клиента</span>
      </div>

      <div class="modal-footer">
        <a href={bookingHref} class="modal-book-btn">{t.modalBtnText}</a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  /* ==== Модалка ==== */
  function initPortfolioModal() {
    const cards = document.querySelectorAll(".case-card");
    const modal = document.getElementById("portfolio-modal");
    const closeBtn = document.getElementById("close-portfolio-modal");
    if (!modal || !closeBtn) return;

    const mTitle = document.getElementById("modal-title");
    const mCategory = document.getElementById("modal-category");
    const mLocation = document.getElementById("modal-location");
    const mGuests = document.getElementById("modal-guests");
    const mBudget = document.getElementById("modal-budget");
    const mDescription = document.getElementById("modal-description");
    const mReview = document.getElementById("modal-review");
    const mClient = document.getElementById("modal-client");
    const mImage = document.getElementById("modal-image");

    function openFromCard(card) {
      mTitle.textContent = card.dataset.title || "";
      mCategory.textContent = card.dataset.category || "";
      mLocation.textContent = "📍 " + (card.dataset.location || "");
      mGuests.textContent = card.dataset.guests || "";
      mBudget.textContent = card.dataset.budget || "";
      mDescription.textContent = card.dataset.description || "";
      mReview.textContent = card.dataset.review || "";
      mClient.textContent = card.dataset.client || "";
      mImage.src = card.dataset.image || "";
      mImage.alt = card.dataset.title || "";
      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    cards.forEach((card) => {
      if (card.dataset.modalInit === "1") return;
      card.dataset.modalInit = "1";
      let startX = 0;
      let startY = 0;
      let moved = false;
      card.addEventListener("pointerdown", (e) => {
        startX = e.clientX;
        startY = e.clientY;
        moved = false;
      });
      card.addEventListener("pointermove", (e) => {
        if (Math.abs(e.clientX - startX) > 8 || Math.abs(e.clientY - startY) > 8) {
          moved = true;
        }
      });
      card.addEventListener("click", (e) => {
        if (moved) return;
        const g = e.target.closest(".case-gallery");
        if (g && g.dataset.dragged === "1") return;
        openFromCard(card);
      });
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openFromCard(card);
        }
      });
    });

    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  }

  /* ==== Флаг drag для фото-галереи ==== */
  function initGalleryDragFlag() {
    document.querySelectorAll(".case-gallery").forEach((gallery) => {
      if (gallery.dataset.dragInit === "1") return;
      gallery.dataset.dragInit = "1";

      let startX = 0, startY = 0;
      gallery.addEventListener("touchstart", (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        gallery.dataset.dragged = "0";
      }, { passive: true });
      gallery.addEventListener("touchmove", (e) => {
        const dx = Math.abs(e.touches[0].clientX - startX);
        const dy = Math.abs(e.touches[0].clientY - startY);
        if (dx > 8 && dx > dy) gallery.dataset.dragged = "1";
      }, { passive: true });
      gallery.addEventListener("touchend", () => {
        setTimeout(() => { gallery.dataset.dragged = "0"; }, 60);
      }, { passive: true });
    });
  }

  function bootPortfolio() {
    initPortfolioModal();
    initGalleryDragFlag();
  }

  document.addEventListener("DOMContentLoaded", bootPortfolio);
  document.addEventListener("astro:page-load", bootPortfolio);
  bootPortfolio();
</script>

