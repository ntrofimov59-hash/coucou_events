}[lang as "ru" | "eng" | "esp" | "arm"] || {
  sectionTag: "Избранные кейсы",
  heading: "Реализованные проекты",
  subtitle:
    "Листайте карточки, чтобы посмотреть детали проектов и отзывы клиентов.",
  modalGuests: "Масштаб:",
  modalBudget: "Бюджет:",
  modalAbout: "О проекте:",
  modalReviewTitle: "Отзыв клиента:",
  modalBtnText: "Забронировать похожий проект",
  items: [],
};

const bookingHref = `/${lang}/booking`;
---

<section id="portfolio" class="portfolio-section" lang={lang}>
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t.sectionTag}</span>
      <h2 class="font-serif">{t.heading}</h2>
      <p class="subtitle font-light">{t.subtitle}</p>
    </div>

    <div class="portfolio-swiper-wrap">
      <div class="portfolio-nav">
        <button
          class="portfolio-nav-btn portfolio-nav-prev"
          type="button"
          aria-label="Предыдущий кейс"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="portfolio-pagination"></div>

        <button
          class="portfolio-nav-btn portfolio-nav-next"
          type="button"
          aria-label="Следующий кейс"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <Swiper
        options={{
          slidesPerView: 1,
          spaceBetween: 24,
          allowTouchMove: true,
          navigation: {
            prevEl: '.portfolio-nav-prev',
            nextEl: '.portfolio-nav-next',
          },
          pagination: {
            el: '.portfolio-pagination',
            clickable: true,
          },
          loop: false,
          grabCursor: false,
          breakpoints: {
            0: { allowTouchMove: true },
            901: { allowTouchMove: false },
          },
        }}
      >
        <SwiperWrapper>
          {
            t.items.map((item) => (
              <SwiperSlide>
                <article
                  class="case-card"
                  role="button"
                  tabindex="0"
                  aria-label={item.title}
                  data-title={item.title}
                  data-category={item.category}
                  data-location={item.location}
                  data-guests={item.guests}
                  data-budget={item.budget}
                  data-description={item.description}
                  data-review={item.review}
                  data-client={item.client}
                  data-image={item.images[0]}
                  data-images={JSON.stringify(item.images)}
                >
                  <div class="case-gallery" data-count={item.images.length}>
                    {item.images.map((img, idx) => (
                      <div class="case-image">
                        <img
                          src={img}
                          alt={`${item.title} — фото ${idx + 1}`}
                          loading="lazy"
                        />
                        <span class="photo-counter">
                          {idx + 1} / {item.images.length}
                        </span>
                      </div>
                    ))}
                  </div>

                  <div class="case-info">
                    <div class="case-top">
                      <span class="card-category">{item.category}</span>
                      <span class="card-location">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                      {item.location}
                    </span>
                    </div>

                    <h3 class="font-serif">{item.title}</h3>

                    <p class="case-description">{item.description}</p>

                    <div class="case-meta">
                      <span>
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        {item.guests}
                      </span>
                      <span>
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        {item.budget}
                      </span>
                    </div>

                    <div class="case-cta">
                      <span>Подробнее</span>
                      <span class="case-arrow">→</span>
                    </div>
                  </div>
                </article>
              </SwiperSlide>
            ))
          }
        </SwiperWrapper>
      </Swiper>
    </div>
  </div>
</section>

<div class="portfolio-modal-overlay" id="portfolio-modal" aria-hidden="true">
  <div class="portfolio-modal-content" role="dialog" aria-modal="true">
    <button
      class="modal-close"
      id="close-portfolio-modal"
      type="button"
      aria-label="Close"
    >
      &times;
    </button>

    <div class="modal-gallery">
      <div class="modal-gallery-track" data-modal-track></div>

      <button
        class="modal-gallery-arrow modal-gallery-prev"
        type="button"
        aria-label="Предыдущее фото"
        data-modal-prev
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="modal-gallery-arrow modal-gallery-next"
        type="button"
        aria-label="Следующее фото"
        data-modal-next
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="modal-gallery-indicator">
        <span class="modal-gallery-dots" data-modal-dots></span>
        <span class="modal-gallery-counter">
          <span data-modal-current>1</span>
          <span class="modal-gallery-counter-sep">/</span>
          <span data-modal-total>1</span>
        </span>
      </div>

      <span class="modal-tag" id="modal-category">Категория</span>
    </div>

    <div class="modal-body">
      <h2 id="modal-title" class="font-serif">Название проекта</h2>
      <p class="modal-location">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="modal-location">Локация</span>
      </p>

      <div class="modal-info-grid">
        <div>
          <span>{t.modalGuests}</span>
          <strong id="modal-guests">-</strong>
        </div>
        <div>
          <span>{t.modalBudget}</span>
          <strong id="modal-budget">-</strong>
        </div>
      </div>

      <div class="modal-section">
        <h4>{t.modalAbout}</h4>
        <p id="modal-description">Описание...</p>
      </div>

      <div class="modal-review-box">
        <h4>{t.modalReviewTitle}</h4>
        <p id="modal-review">«Отзыв»</p>
        <span class="modal-client" id="modal-client">Имя клиента</span>
      </div>

      <div class="modal-footer">
        <a href={bookingHref} class="modal-book-btn">{t.modalBtnText}</a>
      </div>
    </div>
  </div>
</div>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: t.heading,
    itemListElement: t.items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "CreativeWork",
        name: item.title,
        description: item.description,
        about: item.category,
        locationCreated: {
          "@type": "Place",
          name: item.location,
        },
        image: `${SITE_URL}${item.images[0]}`,
      },
    })),
  })}
/>

<script is:inline>
  /* ==== Модалка с галереей ==== */
  function initPortfolioModal() {
    const cards = document.querySelectorAll(".case-card");
    const modal = document.getElementById("portfolio-modal");
    const closeBtn = document.getElementById("close-portfolio-modal");
    if (!modal || !closeBtn) return;
    if (modal.dataset.portfolioBound === "1") return;
    modal.dataset.portfolioBound = "1";

    const mTitle = document.getElementById("modal-title");
    const mCategory = document.getElementById("modal-category");
    const mLocation = document.getElementById("modal-location");
    const mGuests = document.getElementById("modal-guests");
    const mBudget = document.getElementById("modal-budget");
    const mDescription = document.getElementById("modal-description");
    const mReview = document.getElementById("modal-review");
    const mClient = document.getElementById("modal-client");

    const track = modal.querySelector("[data-modal-track]");
    const prevBtn = modal.querySelector("[data-modal-prev]");
    const nextBtn = modal.querySelector("[data-modal-next]");
    const dotsWrap = modal.querySelector("[data-modal-dots]");
    const curEl = modal.querySelector("[data-modal-current]");
    const totalEl = modal.querySelector("[data-modal-total]");
    const indicator = modal.querySelector(".modal-gallery-indicator");

    function slideCount() {
      return track ? track.querySelectorAll(".modal-gallery-slide").length : 0;
    }
    function currentIndex() {
      const total = slideCount();
      if (!total || !track) return 0;
      const w = track.clientWidth || 1;
      return Math.min(total - 1, Math.max(0, Math.round(track.scrollLeft / w)));
    }
    function setActive(i) {
      const total = slideCount();
      if (curEl) curEl.textContent = String(total ? i + 1 : 0);
      if (totalEl) totalEl.textContent = String(total);
      if (dotsWrap) {
        Array.from(dotsWrap.children).forEach((d, k) => d.classList.toggle("is-active", k === i));
      }
      if (prevBtn) prevBtn.disabled = i <= 0;
      if (nextBtn) nextBtn.disabled = i >= total - 1;
    }
    function goTo(i) {
      const total = slideCount();
      if (!total || !track) return;
      i = Math.max(0, Math.min(total - 1, i));
      track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
      setActive(i);
    }
    function next() { goTo(currentIndex() + 1); }
    function prev() { goTo(currentIndex() - 1); }

    function refreshNav(total) {
      const single = total <= 1;
      if (prevBtn) prevBtn.style.display = single ? "none" : "";
      if (nextBtn) nextBtn.style.display = single ? "none" : "";
      if (indicator) indicator.style.display = single ? "none" : "";
      if (totalEl) totalEl.textContent = String(total);
      if (curEl) curEl.textContent = total ? "1" : "0";
      if (dotsWrap) {
        dotsWrap.innerHTML = "";
        for (let k = 0; k < total; k++) {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "modal-gallery-dot" + (k === 0 ? " is-active" : "");
          dot.setAttribute("aria-label", "Photo " + (k + 1));
          dot.addEventListener("click", () => goTo(k));
          dotsWrap.appendChild(dot);
        }
      }
      if (track) track.scrollLeft = 0;
      setActive(0);
    }

    function buildGallery(images) {
      if (!track) return;
      track.innerHTML = "";
      if (!images || !images.length) return;
      images.forEach((src, i) => {
        const slide = document.createElement("div");
        slide.className = "modal-gallery-slide";
        const img = document.createElement("img");
        img.src = src;
        img.alt = "";
        img.loading = i === 0 ? "eager" : "lazy";
        slide.appendChild(img);
        track.appendChild(slide);
      });
      refreshNav(images.length);
    }

    function openFromCard(card) {
      mTitle.textContent = card.dataset.title || "";
      mCategory.textContent = card.dataset.category || "";
      mLocation.textContent = card.dataset.location || "";
      mGuests.textContent = card.dataset.guests || "";
      mBudget.textContent = card.dataset.budget || "";
      mDescription.textContent = card.dataset.description || "";
      mReview.textContent = card.dataset.review || "";
      mClient.textContent = card.dataset.client || "";

      let images = [];
      try { images = JSON.parse(card.dataset.images || "[]"); } catch (e) { images = []; }
      if (!images.length && card.dataset.image) images = [card.dataset.image];
      buildGallery(images);

      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    if (prevBtn) prevBtn.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
    if (nextBtn) nextBtn.addEventListener("click", (e) => { e.stopPropagation(); next(); });

    if (track) {
      let scrollT = null;
      track.addEventListener("scroll", () => {
        if (scrollT) clearTimeout(scrollT);
        scrollT = setTimeout(() => setActive(currentIndex()), 80);
      }, { passive: true });

      let downX = 0, downY = 0, dragging = false;
      track.addEventListener("pointerdown", (e) => {
        downX = e.clientX; downY = e.clientY; dragging = false;
      });
      track.addEventListener("pointermove", (e) => {
        if (Math.abs(e.clientX - downX) > 8 || Math.abs(e.clientY - downY) > 8) dragging = true;
      });
      track.addEventListener("click", (e) => {
        if (dragging) return;
        if (!e.target.closest("img")) return;
        if (slideCount() <= 1) return;
        next();
      });
    }

    cards.forEach((card) => {
      if (card.dataset.modalInit === "1") return;
      card.dataset.modalInit = "1";
      let startX = 0, startY = 0, moved = false;
      card.addEventListener("pointerdown", (e) => { startX = e.clientX; startY = e.clientY; moved = false; });
      card.addEventListener("pointermove", (e) => {
        if (Math.abs(e.clientX - startX) > 8 || Math.abs(e.clientY - startY) > 8) moved = true;
      });
      card.addEventListener("click", () => { if (!moved) openFromCard(card); });
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openFromCard(card); }
      });
    });

    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
  }

  function bootPortfolio() {
    initPortfolioModal();
    initGalleryAutoScroll();
  }

  document.addEventListener("DOMContentLoaded", bootPortfolio);
  document.addEventListener("astro:page-load", bootPortfolio);
  bootPortfolio();
</script>

