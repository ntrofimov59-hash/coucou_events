const dict = (t as Record<string, typeof t.ru>)[lang] || t.ru;
const bookingHref = `/${lang}/booking`;
---

<section id="portfolio" class="formats-section" lang={lang}>
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{dict.sectionTag}</span>
      <h2 class="font-serif">{dict.heading}</h2>
      <p class="subtitle font-light">{dict.subtitle}</p>
    </div>

    <div class="formats-swiper-wrap">
      <div class="formats-nav">
        <button class="formats-nav-btn formats-nav-prev" type="button" aria-label="Prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <div class="formats-pagination"></div>
        <button class="formats-nav-btn formats-nav-next" type="button" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <Swiper
        options={{
          slidesPerView: 1,
          spaceBetween: 24,
          allowTouchMove: true,
          navigation: { prevEl: ".formats-nav-prev", nextEl: ".formats-nav-next" },
          pagination: { el: ".formats-pagination", clickable: true },
          loop: false,
          grabCursor: false,
          breakpoints: { 0: { allowTouchMove: true }, 901: { allowTouchMove: false } },
        }}
      >
        <SwiperWrapper>
          {
            dict.items.map((item) => (
              <SwiperSlide>
                <article
                  class="format-card"
                  role="button"
                  tabindex="0"
                  aria-label={item.title}
                  data-title={item.title}
                  data-format={item.format}
                  data-location={item.location}
                  data-description={item.description}
                  data-guests={item.guests}
                  data-budget={item.budget}
                  data-images={JSON.stringify(item.images)}
                >
                  {item.hasBeforeAfter && item.before && item.after ? (
                    <div class="ba-grid">
                      <div class="ba-col ba-before">
                        <span class="ba-label">{dict.beforeLabel}</span>
                        <div class="ba-photos">
                          {item.before.map((src, i) => (
                            <div class="ba-photo">
                              <img src={src} alt={`${item.title} — ${dict.beforeLabel} ${i + 1}`} loading="lazy" />
                            </div>
                          ))}
                        </div>
                      </div>
                      <div class="ba-col ba-after">
                        <span class="ba-label">{dict.afterLabel}</span>
                        <div class="ba-photos">
                          {item.after.map((src, i) => (
                            <div class="ba-photo">
                              <img src={src} alt={`${item.title} — ${dict.afterLabel} ${i + 1}`} loading="lazy" />
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class={`photo-grid count-${Math.min(item.images.length, 4)}`}>
                      {item.images.slice(0, 4).map((src, i) => (
                        <div class="grid-photo">
                          <img src={src} alt={`${item.title} — ${i + 1}`} loading="lazy" />
                        </div>
                      ))}
                    </div>
                  )}

                  <div class="format-info">
                    <div class="format-top">
                      <span class="card-format">{item.format}</span>
                      <span class="card-location">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        {item.location}
                      </span>
                    </div>

                    <h3 class="font-serif">{item.title}</h3>
                    <p class="format-description">{item.description}</p>

                    <div class="format-meta" title={dict.modalDisclaimer}>
                      <span class="meta-item">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        {item.guests}
                      </span>
                      <span class="meta-dot">·</span>
                      <span class="meta-item meta-budget">{item.budget}</span>
                    </div>

                    <div class="format-cta">
                      <span>{dict.cta}</span>
                      <span class="format-arrow">→</span>
                    </div>
                  </div>
                </article>
              </SwiperSlide>
            ))
          }
        </SwiperWrapper>
      </Swiper>
    </div>
  </div>
</section>

<div class="formats-modal-overlay" id="formats-modal" aria-hidden="true">
  <div class="formats-modal-content" role="dialog" aria-modal="true">
    <button class="modal-close" id="close-formats-modal" type="button" aria-label="Close">&times;</button>

    <div class="modal-gallery">
      <div class="modal-gallery-track" data-modal-track></div>
      <button class="modal-gallery-arrow modal-gallery-prev" type="button" data-modal-prev aria-label="Prev">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="modal-gallery-arrow modal-gallery-next" type="button" data-modal-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <div class="modal-gallery-indicator">
        <span class="modal-gallery-dots" data-modal-dots></span>
        <span class="modal-gallery-counter">
          <span data-modal-current>1</span><span class="modal-gallery-counter-sep">/</span><span data-modal-total>1</span>
        </span>
      </div>
      <span class="modal-tag" id="modal-format">Формат</span>
    </div>

    <div class="modal-body">
      <h2 id="modal-title" class="font-serif">Название</h2>
      <p class="modal-location">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="modal-location">Локация</span>
      </p>

      <div class="modal-meta-row">
        <div>
          <span class="meta-label">{dict.modalGuests}</span>
          <strong id="modal-guests">—</strong>
        </div>
        <div>
          <span class="meta-label">{dict.modalBudget}</span>
          <strong id="modal-budget">—</strong>
        </div>
      </div>
      <p class="modal-disclaimer">{dict.modalDisclaimer}</p>

      <div class="modal-section">
        <h4>{dict.modalAbout}</h4>
        <p id="modal-description">Описание...</p>
      </div>

      <div class="modal-footer">
        <a href={bookingHref} class="modal-book-btn">{dict.modalBtnText}</a>
      </div>
    </div>
  </div>
</div>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: dict.heading,
    itemListElement: dict.items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "CreativeWork",
        name: item.title,
        description: item.description,
        about: item.format,
        locationCreated: { "@type": "Place", name: item.location },
        image: `${SITE_URL}${item.images[0]}`,
      },
    })),
  })}
/>

<script is:inline>
  function initFormatsModal() {
    const cards = document.querySelectorAll(".format-card");
    const modal = document.getElementById("formats-modal");
    const closeBtn = document.getElementById("close-formats-modal");
    if (!modal || !closeBtn) return;
    if (modal.dataset.formatsBound === "1") return;
    modal.dataset.formatsBound = "1";

    const mTitle = document.getElementById("modal-title");
    const mFormat = document.getElementById("modal-format");
    const mLocation = document.getElementById("modal-location");
    const mGuests = document.getElementById("modal-guests");
    const mBudget = document.getElementById("modal-budget");
    const mDescription = document.getElementById("modal-description");
    const track = modal.querySelector("[data-modal-track]");
    const prevBtn = modal.querySelector("[data-modal-prev]");
    const nextBtn = modal.querySelector("[data-modal-next]");
    const dotsWrap = modal.querySelector("[data-modal-dots]");
    const curEl = modal.querySelector("[data-modal-current]");
    const totalEl = modal.querySelector("[data-modal-total]");
    const indicator = modal.querySelector(".modal-gallery-indicator");

    function slideCount() {
      return track ? track.querySelectorAll(".modal-gallery-slide").length : 0;
    }
    function currentIndex() {
      const total = slideCount();
      if (!total || !track) return 0;
      const w = track.clientWidth || 1;
      return Math.min(total - 1, Math.max(0, Math.round(track.scrollLeft / w)));
    }
    function setActive(i) {
      const total = slideCount();
      if (curEl) curEl.textContent = String(total ? i + 1 : 0);
      if (totalEl) totalEl.textContent = String(total);
      if (dotsWrap) Array.from(dotsWrap.children).forEach((d, k) => d.classList.toggle("is-active", k === i));
      if (prevBtn) prevBtn.disabled = i <= 0;
      if (nextBtn) nextBtn.disabled = i >= total - 1;
    }
    function goTo(i) {
      const total = slideCount();
      if (!total || !track) return;
      i = Math.max(0, Math.min(total - 1, i));
      track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
      setActive(i);
    }

    function refreshNav(total) {
      const single = total <= 1;
      if (prevBtn) prevBtn.style.display = single ? "none" : "";
      if (nextBtn) nextBtn.style.display = single ? "none" : "";
      if (indicator) indicator.style.display = single ? "none" : "";
      if (dotsWrap) {
        dotsWrap.innerHTML = "";
        for (let k = 0; k < total; k++) {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "modal-gallery-dot" + (k === 0 ? " is-active" : "");
          dot.addEventListener("click", () => goTo(k));
          dotsWrap.appendChild(dot);
        }
      }
      if (track) track.scrollLeft = 0;
      setActive(0);
    }

    function buildGallery(images) {
      if (!track) return;
      track.innerHTML = "";
      if (!images || !images.length) return;
      images.forEach((src, i) => {
        const slide = document.createElement("div");
        slide.className = "modal-gallery-slide";
        const img = document.createElement("img");
        img.src = src;
        img.alt = "";
        img.loading = i === 0 ? "eager" : "lazy";
        slide.appendChild(img);
        track.appendChild(slide);
      });
      refreshNav(images.length);
    }

    function openFromCard(card) {
      mTitle.textContent = card.dataset.title || "";
      mFormat.textContent = card.dataset.format || "";
      mLocation.textContent = card.dataset.location || "";
      mGuests.textContent = card.dataset.guests || "—";
      mBudget.textContent = card.dataset.budget || "—";
      mDescription.textContent = card.dataset.description || "";
      let images = [];
      try { images = JSON.parse(card.dataset.images || "[]"); } catch (e) {}
      buildGallery(images);
      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    if (prevBtn) prevBtn.addEventListener("click", (e) => { e.stopPropagation(); goTo(currentIndex() - 1); });
    if (nextBtn) nextBtn.addEventListener("click", (e) => { e.stopPropagation(); goTo(currentIndex() + 1); });
    if (track) {
      let t = null;
      track.addEventListener("scroll", () => {
        if (t) clearTimeout(t);
        t = setTimeout(() => setActive(currentIndex()), 80);
      }, { passive: true });
    }

    cards.forEach((card) => {
      if (card.dataset.modalInit === "1") return;
      card.dataset.modalInit = "1";
      let sx = 0, sy = 0, moved = false;
      card.addEventListener("pointerdown", (e) => { sx = e.clientX; sy = e.clientY; moved = false; });
      card.addEventListener("pointermove", (e) => {
        if (Math.abs(e.clientX - sx) > 8 || Math.abs(e.clientY - sy) > 8) moved = true;
      });
      card.addEventListener("click", () => { if (!moved) openFromCard(card); });
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openFromCard(card); }
      });
    });

    closeBtn.addEventListener("click", closeModal);
