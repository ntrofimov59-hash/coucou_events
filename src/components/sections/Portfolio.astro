---
import { Swiper, SwiperWrapper, SwiperSlide } from "astro-swiper";
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";
import { SITE_URL } from "@/config/site";

interface Props {
  lang?: string;
}

const { lang = "ru" } = Astro.props;

type FormatItem = {
  id: string;
  title: string;
  format: string;
  location: string;
  description: string;
  guests: string;
  budget: string;
  hasBeforeAfter: boolean;
  before?: string[];
  after?: string[];
  images: string[];
};

