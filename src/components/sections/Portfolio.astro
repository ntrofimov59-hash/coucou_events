          "Հինգհարկանի տորթը՝ ալիումի ծաղիկներով շրջապատված պատվանդանի վրա, դարձավ ամբողջ վրանի գունային ուղղորդիչը՝ մանուշակագույն վարագույրներ, մանուշակագույն ծաղիկների կենդանի ցանկապատ։",
        review:
          "«Տորթը դարձավ հարսանիքի երկրորդ ամենալուսանկարված օբյեկտը՝ մեզանից հետո։ Ճիշտ այն, ինչ ուզում էինք։»",
        client: "Մարիա Կ.",
        images: [
          "/images/portfolio/portfolio-allium-cake-hero.webp",
          "/images/portfolio/portfolio-allium-cake-card.webp",
        ],
      },
      {
        id: "oak-reception",
        title: "Ընթրիք դարավոր կաղնիների տակ",
        category: "Հարսանիք բանալի ձեռքին",
        location: "Պատմական կալվածք",
        guests: "120+ հյուր",
        budget: "$200k-ից",
        span: "col-span-2 row-span-1",
        description:
          "Թափանցիկ վրանը տեղադրվեց այնպես, որ իսպանական մամուռով ծածկված դարավոր կաղնիների պսակը դառնա ինտերիերի մաս, ոչ թե ֆոն։ Հյուրերն ընթրում էին երկար սեղանների շուրջ՝ ուղիղ ճյուղերի տակ։",
        review:
          "«Հենց այս ծառերի համար ընտրեցինք հարթակը, և թիմը դրանք չծածկեց վրանով, այլ կառուցեց երեկոն դրանց շուրջ։»",
        client: "Էմիլի և Ջեքսոն",
        images: [
          "/images/portfolio/portfolio-oak-reception-hero.webp",
          "/images/portfolio/portfolio-oak-reception-card.webp",
        ],
      },
      {
        id: "beach-dinner",
        title: "Մասնավոր ընթրիք օվկիանոսի ափին",
        category: "Մասնավոր երեկո",
        location: "Արևադարձային կղզի",
        guests: "16 հյուր",
        budget: "$60k",
        span: "col-span-1 row-span-1",
        description:
          "Ինտիմ ընթրիք ուղիղ ավազի վրա՝ պագոդա-վրաններ լույսերով, բորդո տեքստիլ, գորգեր և կենդանի երաժշտություն։ Ձևաչափ նրանց համար, ովքեր կարևորում են հյուրերի մերձեցումը, ոչ թե մասշտաբը։",
        review:
          "«Տասնհինգ մարդ, ում սիրում ենք, կենդանի երաժշտություն և օվկիանոսը՝ երեք մետր հեռավորության վրա։ Կատարյալ երեկո։»",
        client: "Դարիա և Նիկիտա",
        images: [
          "/images/portfolio/portfolio-beach-dinner-hero.webp",
          "/images/portfolio/portfolio-beach-dinner-card.webp",
        ],
      },
      {
        id: "bamboo-bar",
        title: "Բարային գոտի ներքին բակում",
        category: "Քեյթերինգ և բար",
        location: "Քաղաքային առանձնատուն",
        guests: "120+ հյուր",
        budget: "$130k",
        span: "col-span-1 row-span-1",
        description:
          "Ձեռագործ բարի պահարան՝ աղյուսե պատի և բարձր բամբուկի ֆոնին. խմիչքների գոտին նախագծված է որպես առանձին տարածք, ոչ թե կողային սեղան։",
        review:
          "«Բարը կարծես տարիներ շարունակ այնտեղ էր կանգնած, ոչ թե բերված մեկ երեկոյի համար։»",
        client: "Կազմակերպչական խումբ",
        images: [
          "/images/portfolio/portfolio-bamboo-bar-hero.webp",
          "/images/portfolio/portfolio-bamboo-bar-card.webp",
        ],
      },
    ],
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  sectionTag: "Избранные кейсы",
  heading: "Реализованные проекты",
  subtitle:
    "Листайте карточки, чтобы посмотреть детали проектов и отзывы клиентов.",
  modalGuests: "Масштаб:",
  modalBudget: "Бюджет:",
  modalAbout: "О проекте:",
  modalReviewTitle: "Отзыв клиента:",
  modalBtnText: "Забронировать похожий проект",
  items: [],
};

const bookingHref = `/${lang}/booking`;
---

<section id="portfolio" class="portfolio-section" lang={lang}>
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t.sectionTag}</span>
      <h2 class="font-serif">{t.heading}</h2>
      <p class="subtitle font-light">{t.subtitle}</p>
    </div>

    <div class="portfolio-swiper-wrap">
      <div class="portfolio-nav">
        <button
          class="portfolio-nav-btn portfolio-nav-prev"
          type="button"
          aria-label="Предыдущий кейс"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="portfolio-pagination"></div>

        <button
          class="portfolio-nav-btn portfolio-nav-next"
          type="button"
          aria-label="Следующий кейс"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <Swiper
        options={{
          slidesPerView: 1,
          spaceBetween: 24,
          allowTouchMove: true,
          navigation: {
            prevEl: '.portfolio-nav-prev',
            nextEl: '.portfolio-nav-next',
          },
          pagination: {
            el: '.portfolio-pagination',
            clickable: true,
          },
          loop: false,
          grabCursor: false,
          breakpoints: {
            0: { allowTouchMove: true },
            901: { allowTouchMove: false },
          },
        }}
      >
        <SwiperWrapper>
          {
            t.items.map((item) => (
              <SwiperSlide>
                <article
                  class="case-card"
                  role="button"
                  tabindex="0"
                  aria-label={item.title}
                  data-title={item.title}
                  data-category={item.category}
                  data-location={item.location}
                  data-guests={item.guests}
                  data-budget={item.budget}
                  data-description={item.description}
                  data-review={item.review}
                  data-client={item.client}
                  data-image={item.images[0]}
                  data-images={JSON.stringify(item.images)}
                >
                  <div class="case-gallery" data-count={item.images.length}>
                    {item.images.map((img, idx) => (
                      <div class="case-image">
                        <img
                          src={img}
                          alt={`${item.title} — фото ${idx + 1}`}
                          loading="lazy"
                        />
                        <span class="photo-counter">
                          {idx + 1} / {item.images.length}
                        </span>
                      </div>
                    ))}
                  </div>

                  <div class="case-info">
                    <div class="case-top">
                      <span class="card-category">{item.category}</span>
                      <span class="card-location">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                      {item.location}
                    </span>
                    </div>

                    <h3 class="font-serif">{item.title}</h3>

                    <p class="case-description">{item.description}</p>

                    <div class="case-meta">
                      <span>
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        {item.guests}
                      </span>
                      <span>
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        {item.budget}
                      </span>
                    </div>

                    <div class="case-cta">
                      <span>Подробнее</span>
                      <span class="case-arrow">→</span>
                    </div>
                  </div>
                </article>
              </SwiperSlide>
            ))
          }
        </SwiperWrapper>
      </Swiper>
    </div>
  </div>
</section>

<div class="portfolio-modal-overlay" id="portfolio-modal" aria-hidden="true">
  <div class="portfolio-modal-content" role="dialog" aria-modal="true">
    <button
      class="modal-close"
      id="close-portfolio-modal"
      type="button"
      aria-label="Close"
    >
      &times;
    </button>

    <div class="modal-gallery">
      <div class="modal-gallery-track" data-modal-track></div>

      <button
        class="modal-gallery-arrow modal-gallery-prev"
        type="button"
        aria-label="Предыдущее фото"
        data-modal-prev
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="modal-gallery-arrow modal-gallery-next"
        type="button"
        aria-label="Следующее фото"
        data-modal-next
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="modal-gallery-indicator">
        <span class="modal-gallery-dots" data-modal-dots></span>
        <span class="modal-gallery-counter">
          <span data-modal-current>1</span>
          <span class="modal-gallery-counter-sep">/</span>
          <span data-modal-total>1</span>
        </span>
      </div>

      <span class="modal-tag" id="modal-category">Категория</span>
    </div>

    <div class="modal-body">
      <h2 id="modal-title" class="font-serif">Название проекта</h2>
      <p class="modal-location">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="modal-location">Локация</span>
      </p>

      <div class="modal-info-grid">
        <div>
          <span>{t.modalGuests}</span>
          <strong id="modal-guests">-</strong>
        </div>
        <div>
          <span>{t.modalBudget}</span>
          <strong id="modal-budget">-</strong>
        </div>
      </div>

      <div class="modal-section">
        <h4>{t.modalAbout}</h4>
        <p id="modal-description">Описание...</p>
      </div>

      <div class="modal-review-box">
        <h4>{t.modalReviewTitle}</h4>
        <p id="modal-review">«Отзыв»</p>
        <span class="modal-client" id="modal-client">Имя клиента</span>
      </div>

      <div class="modal-footer">
        <a href={bookingHref} class="modal-book-btn">{t.modalBtnText}</a>
      </div>
    </div>
  </div>
</div>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: t.heading,
    itemListElement: t.items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "CreativeWork",
        name: item.title,
        description: item.description,
        about: item.category,
        locationCreated: {
          "@type": "Place",
          name: item.location,
        },
        image: `${SITE_URL}${item.images[0]}`,
      },
    })),
  })}
/>

<script is:inline>
  /* ==== Модалка с галереей ==== */
  function initPortfolioModal() {
    const cards = document.querySelectorAll(".case-card");
    const modal = document.getElementById("portfolio-modal");
    const closeBtn = document.getElementById("close-portfolio-modal");
    if (!modal || !closeBtn) return;

    const mTitle = document.getElementById("modal-title");
    const mCategory = document.getElementById("modal-category");
    const mLocation = document.getElementById("modal-location");
    const mGuests = document.getElementById("modal-guests");
    const mBudget = document.getElementById("modal-budget");
    const mDescription = document.getElementById("modal-description");
    const mReview = document.getElementById("modal-review");
    const mClient = document.getElementById("modal-client");

    const track = modal.querySelector("[data-modal-track]");
    let autoTimer = null;

    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
      if (track) {
        track.style.transform = "";
        const container = track.closest(".modal-gallery");
        if (container) container.scrollTop = 0;
      }
    }

    function animateScrollTo(container, targetTop) {
      const startTop = container.scrollTop;
      const distance = targetTop - startTop;
      if (Math.abs(distance) < 2) return;
      const speed = 500; // px/s — единая скорость
      const duration = Math.max(400, Math.abs(distance) / speed * 1000);
      const startTime = performance.now();
      function step(now) {
        const t = Math.min((now - startTime) / duration, 1);
        const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        container.scrollTop = startTop + distance * eased;
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function startAuto() {
      stopAuto();
      if (!track) return;
      if (window.innerWidth > 900) return; // только на мобильном
      const container = track.closest(".modal-gallery");
      if (!container) return;
      const slides = track.querySelectorAll(".modal-gallery-slide");
      if (slides.length < 2) return;

      const firstImg = slides[0].querySelector("img");
      const setH = () => {
        if (!firstImg || !firstImg.naturalWidth) return;
        const w = container.clientWidth;
        const natural = Math.round(w * (firstImg.naturalHeight / firstImg.naturalWidth));
        const maxH = Math.round(window.innerHeight * 0.65);
        container.style.height = Math.min(natural, maxH) + "px";
      };
      if (firstImg && firstImg.complete && firstImg.naturalWidth) setH();
      else if (firstImg) firstImg.addEventListener("load", setH, { once: true });

      let idx = 0;
      autoTimer = setInterval(() => {
        idx = (idx + 1) % slides.length;
        const target = slides[idx];
        animateScrollTo(container, target.offsetTop);
      }, 3800);
    }

    function buildGallery(images) {
      if (!track) return;
      track.innerHTML = "";
      track.style.transition = "";
      track.style.transform = "";
      stopAuto();
      if (!images || !images.length) return;

      const isMobile = window.innerWidth <= 900;
      const list = isMobile ? images : [images[0]];

      list.forEach((src, i) => {
        const slide = document.createElement("div");
        slide.className = "modal-gallery-slide";
        const img = document.createElement("img");
        img.src = src;
        img.alt = "";
        img.loading = i === 0 ? "eager" : "lazy";
        slide.appendChild(img);
        track.appendChild(slide);
      });
    }

    function openFromCard(card) {
      mTitle.textContent = card.dataset.title || "";
      mCategory.textContent = card.dataset.category || "";
      mLocation.textContent = card.dataset.location || "";
      mGuests.textContent = card.dataset.guests || "";
      mBudget.textContent = card.dataset.budget || "";
      mDescription.textContent = card.dataset.description || "";
      mReview.textContent = card.dataset.review || "";
      mClient.textContent = card.dataset.client || "";

      let images = [];
      try { images = JSON.parse(card.dataset.images || "[]"); } catch (e) { images = []; }
      if (!images.length && card.dataset.image) images = [card.dataset.image];
      buildGallery(images);

      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      setTimeout(startAuto, 80);
    }

    function closeModal() {
      stopAuto();
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    cards.forEach((card) => {
      if (card.dataset.modalInit === "1") return;
      card.dataset.modalInit = "1";
      let startX = 0, startY = 0, moved = false;
      card.addEventListener("pointerdown", (e) => { startX = e.clientX; startY = e.clientY; moved = false; });
      card.addEventListener("pointermove", (e) => {
        if (Math.abs(e.clientX - startX) > 8 || Math.abs(e.clientY - startY) > 8) moved = true;
      });
      card.addEventListener("click", () => { if (!moved) openFromCard(card); });
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openFromCard(card); }
      });
    });

    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
  }

  function bootPortfolio() {
    initPortfolioModal();
    initGalleryAutoScroll();
  }

  document.addEventListener("DOMContentLoaded", bootPortfolio);
  document.addEventListener("astro:page-load", bootPortfolio);
  bootPortfolio();
</script>

<style>
  .portfolio-section {
    padding: 6rem 0;
    background: #f7faf9;
    color: var(--fg, #04100d);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-tag {
    display: inline-block;
    background: rgba(13, 148, 136, 0.1);
    color: #0d9488;
    padding: 0.35rem 1rem;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    border: 1px solid rgba(13, 148, 136, 0.2);
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--fg, #04100d);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .subtitle {
    color: var(--fg-soft, rgba(4, 16, 13, 0.72));
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Навигация над кейсами */
  .portfolio-swiper-wrap {
    width: 100%;
    position: relative;
  }

  .portfolio-nav {
    width: 100%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    margin: 0 auto 2rem;
    padding: 0;
    box-sizing: border-box;
  }

  .portfolio-nav-btn {
    flex: 0 0 auto;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: 1px solid rgba(13, 148, 136, 0.22);
    background: linear-gradient(180deg, #ffffff 0%, #eaf2f0 100%);
    color: #0d9488;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    position: relative;
    margin: 0 !important;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -3px 6px rgba(13, 148, 136, 0.10),
      0 10px 22px -10px rgba(13, 148, 136, 0.55),
      0 4px 10px -3px rgba(10, 40, 34, 0.12);
    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.28s ease,
      color 0.28s ease;
    -webkit-tap-highlight-color: transparent;
    transform: translateZ(0);
  }

  .portfolio-nav-btn svg {
    width: 20px;
    height: 20px;
    display: block;
    stroke: currentColor;
    transition: transform 0.28s ease;
  }

  .portfolio-nav-btn:hover:not(.swiper-button-disabled) {
    transform: translateY(-4px) scale(1.04);
    color: #0f766e;
    background: linear-gradient(180deg, #ffffff 0%, #e0ebe8 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -3px 6px rgba(13, 148, 136, 0.14),
      0 18px 36px -12px rgba(13, 148, 136, 0.65),
      0 8px 16px -5px rgba(10, 40, 34, 0.16);
  }

  .portfolio-nav-btn:hover:not(.swiper-button-disabled).portfolio-nav-prev svg { transform: translateX(-2px); }
  .portfolio-nav-btn:hover:not(.swiper-button-disabled).portfolio-nav-next svg { transform: translateX(2px); }

  .portfolio-nav-btn:active:not(.swiper-button-disabled) {
    transform: translateY(-1px) scale(0.97);
    box-shadow:
      inset 0 2px 6px rgba(13, 148, 136, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 4px 10px -4px rgba(13, 148, 136, 0.35);
  }

  .portfolio-nav-btn:focus-visible {
    outline: 2px solid #0d9488;
    outline-offset: 3px;
  }

  .portfolio-nav-btn.swiper-button-disabled,
  .portfolio-nav-btn[disabled] {
    cursor: not-allowed;
    opacity: 0.45;
    color: rgba(4, 16, 13, 0.45);
    background: linear-gradient(180deg, #f4f7f6 0%, #e8eeec 100%);
    border-color: rgba(4, 16, 13, 0.1);
    transform: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -2px 4px rgba(4, 16, 13, 0.05),
      0 3px 8px -4px rgba(10, 40, 34, 0.15);
  }

  .portfolio-pagination {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: auto !important;
    position: static !important;
    margin: 0 !important;
    padding: 0 0.25rem;
    bottom: auto !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
  }

  .portfolio-pagination :global(.swiper-pagination-bullet) {
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: rgba(4, 16, 13, 0.22) !important;
    opacity: 1 !important;
    margin: 0 5px !important;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.12),
      0 1px 0 rgba(255, 255, 255, 0.6);
    vertical-align: middle;
  }

  .portfolio-pagination :global(.swiper-pagination-bullet:hover) {
    background: rgba(13, 148, 136, 0.55) !important;
    transform: scale(1.25);
  }

  .portfolio-pagination :global(.swiper-pagination-bullet-active) {
    background: linear-gradient(180deg, #14b8a6 0%, #0d9488 100%) !important;
    width: 34px !important;
    border-radius: 6px !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      0 6px 14px -4px rgba(13, 148, 136, 0.65),
      0 2px 4px -1px rgba(10, 40, 34, 0.15);
  }

  /* Swiper */
  .portfolio-swiper-wrap :global(.swiper) {
    width: 100%;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .portfolio-swiper-wrap :global(.swiper-wrapper) {
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: stretch;
    transition-property: transform;
    width: 100%;
    box-sizing: content-box;
  }

  .portfolio-swiper-wrap :global(.swiper-slide) {
    flex-shrink: 0 !important;
    width: 100% !important;
    height: auto;
    display: flex;
    box-sizing: border-box;
    position: relative;
  }

  .case-card {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(4, 16, 13, 0.06);
    box-shadow: 0 20px 40px -25px rgba(10, 40, 34, 0.18);
    min-height: 520px;
    width: 100%;
    cursor: pointer;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .case-card:hover {
    transform: translateY(-3px);
    border-color: rgba(13, 148, 136, 0.35);
    box-shadow: 0 30px 60px -30px rgba(13, 148, 136, 0.25);
  }

  .case-card:focus-visible {
    outline: 2px solid #0d9488;
    outline-offset: 3px;
  }

  /* Bento-галерея (десктоп) */
  .case-gallery {
    display: grid;
    gap: 8px;
    padding: 8px;
    background: #eef4f2;
    min-height: 520px;
    box-sizing: border-box;
  }

  .case-gallery[data-count="1"] { grid-template-columns: 1fr; }
  .case-gallery[data-count="2"] { grid-template-columns: 1fr 1fr; }
  .case-gallery[data-count="3"] {
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .case-gallery[data-count="3"] > .case-image:nth-child(1) { grid-row: span 2; }
  .case-gallery[data-count="4"] {
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .case-gallery[data-count="5"],
  .case-gallery[data-count="6"] {
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .case-gallery[data-count="5"] > .case-image:nth-child(1),
  .case-gallery[data-count="6"] > .case-image:nth-child(1) { grid-row: span 2; }
  .case-gallery[data-count="7"],
  .case-gallery[data-count="8"] {
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .case-gallery[data-count="7"] > .case-image:nth-child(n + 7),
  .case-gallery[data-count="8"] > .case-image:nth-child(n + 7) { display: none; }

  .case-image {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #dbe5e2;
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .case-card:hover .case-image img { transform: scale(1.05); }

  .photo-counter { display: none; }

  /* Инфо кейса */
  .case-info {
    padding: 2.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
  }

  .case-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card-category {
    font-size: 0.72rem;
    color: #0d9488;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    background: rgba(13, 148, 136, 0.1);
    padding: 0.3rem 0.7rem;
    border-radius: 30px;
    border: 1px solid rgba(13, 148, 136, 0.2);
  }

  .card-location {
    font-size: 0.82rem;
    color: rgba(4, 16, 13, 0.62);
    font-weight: 500;
  }

  .case-info h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.95rem);
    color: #04100d;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }

  .case-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(4, 16, 13, 0.72);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .case-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: rgba(4, 16, 13, 0.72);
    padding-top: 0.5rem;
    border-top: 1px solid rgba(4, 16, 13, 0.08);
  }

  .case-cta {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #0d9488;
    font-weight: 600;
    font-size: 0.9rem;
    transition: gap 0.3s ease;
  }

  .case-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(13, 148, 136, 0.12);
    border: 1px solid rgba(13, 148, 136, 0.3);
    transition: all 0.3s ease;
  }

  .case-card:hover .case-cta { gap: 0.9rem; }
  .case-card:hover .case-arrow {
    background: #0d9488;
    color: #fff;
    border-color: #0d9488;
    transform: translateX(3px);
  }

  /* ==== Модалка ==== */
  .portfolio-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .portfolio-modal-overlay.active { opacity: 1; pointer-events: auto; }

  .portfolio-modal-content {
    background: #161619;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    max-width: 620px;
    width: 100%;
    position: relative;
    color: #f4f4f5;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.55);
    transform: translateY(15px);
    transition: transform 0.3s ease;
    overflow: hidden;
    max-height: min(90vh, 720px);
    overflow-y: auto;
  }

  .portfolio-modal-overlay.active .portfolio-modal-content { transform: translateY(0); }

  /* Галерея в модалке */
  .modal-gallery {
    position: relative;
    width: 100%;
    height: 280px;
    background: #0f0f12;
    overflow: hidden;
  }

  .modal-gallery-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }

  .modal-gallery-track::-webkit-scrollbar { display: none; }

  .modal-gallery-slide {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
    position: relative;
  }

  .modal-gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .modal-gallery::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    background: linear-gradient(180deg, rgba(22, 22, 25, 0) 0%, rgba(22, 22, 25, 1) 100%);
    pointer-events: none;
    z-index: 2;
  }

  .modal-gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
    backdrop-filter: blur(6px);
    transition: all 0.22s ease;
    padding: 0;
    opacity: 0.85;
    -webkit-tap-highlight-color: transparent;
  }

  .modal-gallery-arrow svg {
    width: 16px;
    height: 16px;
    display: block;
    stroke: currentColor;
  }

  .modal-gallery-arrow:hover:not(:disabled) {
    background: rgba(13, 148, 136, 0.9);
    border-color: rgba(13, 148, 136, 1);
    opacity: 1;
    transform: translateY(-50%) scale(1.06);
  }

  .modal-gallery-arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .modal-gallery-prev { left: 0.6rem; }
  .modal-gallery-next { right: 0.6rem; }

  .modal-gallery-indicator {
    position: absolute;
    bottom: 0.9rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 5px 12px;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 5;
    pointer-events: auto;
  }

  .modal-gallery-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .modal-gallery-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-gallery-dot:hover {
    background: rgba(94, 234, 212, 0.75);
    transform: scale(1.2);
  }

  .modal-gallery-dot.is-active {
    background: #5eead4;
    width: 16px;
    border-radius: 3px;
    transform: none;
  }

  .modal-gallery-counter {
    font-size: 0.72rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .modal-gallery-counter-sep {
    opacity: 0.5;
  }

  .modal-gallery .modal-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 5;
    background: rgba(13, 148, 136, 0.85);
    border: 1px solid rgba(94, 234, 212, 0.5);
    color: #ffffff;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    backdrop-filter: blur(6px);
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    z-index: 10;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
  }

  .modal-close:hover { background: rgba(0, 0, 0, 0.85); }

  .modal-body { padding: 1.5rem 1.75rem 1.75rem; }

  .portfolio-modal-content h2 {
    font-size: 1.65rem;
    color: #fff;
    margin-bottom: 0.2rem;
    font-weight: 400;
  }

  .modal-location { color: #a1a1aa; font-size: 0.85rem; margin-bottom: 1.25rem; }

  .modal-info-grid {
    display: flex;
    gap: 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }

  .modal-info-grid span {
    color: #ffffff;
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .modal-info-grid strong { color: #ffffff; font-weight: 600; }

  .modal-section { margin-bottom: 1.25rem; }

  .modal-section h4,
  .modal-review-box h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #a1a1aa;
    margin-bottom: 0.35rem;
  }

  .modal-section p { color: #d4d4d8; line-height: 1.5; font-size: 0.9rem; }

  .modal-review-box {
    background: rgba(13, 148, 136, 0.08);
    border-left: 3px solid #0d9488;
    padding: 1rem;
    border-radius: 0 10px 10px 0;
    margin-bottom: 1.5rem;
  }

  .modal-review-box p {
    font-style: italic;
    color: #e4e4e7;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .modal-client { font-size: 0.8rem; color: #5eead4; font-weight: 500; }

  .modal-book-btn {
    display: block;
    width: 100%;
    background: #0d9488;
    color: #fff;
    text-align: center;
    padding: 0.9rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    box-shadow: 0 8px 24px rgba(13, 148, 136, 0.3);
    transition: background 0.2s, box-shadow 0.2s;
  }

  .modal-book-btn:hover {
    background: #0f766e;
    box-shadow: 0 10px 28px rgba(13, 148, 136, 0.35);
  }

  /* ==== Мобильный ==== */
  @media (max-width: 900px) {
    .portfolio-section { padding: 4rem 0; }

    .portfolio-nav {
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .portfolio-nav-btn { width: 50px; height: 50px; }
    .portfolio-nav-btn svg { width: 18px; height: 18px; }
    .portfolio-pagination :global(.swiper-pagination-bullet) {
      width: 9px !important;
      height: 9px !important;
      margin: 0 4px !important;
    }
    .portfolio-pagination :global(.swiper-pagination-bullet-active) {
      width: 28px !important;
    }

    .case-card { grid-template-columns: 1fr; min-height: auto; }

    /* На мобильном — одно фото на карточке */
    .case-gallery,
    .case-gallery[data-count="1"],
    .case-gallery[data-count="2"],
    .case-gallery[data-count="3"],
    .case-gallery[data-count="4"],
    .case-gallery[data-count="5"],
    .case-gallery[data-count="6"],
    .case-gallery[data-count="7"],
    .case-gallery[data-count="8"] {
      display: block !important;
      grid-template-columns: none !important;
      grid-template-rows: none !important;
      height: 300px;
      padding: 0;
      gap: 0;
      overflow: hidden;
      min-height: 0;
      transition: transform 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .case-gallery > .case-image {
      display: block !important;
      grid-row: auto !important;
      grid-column: auto !important;
      border-radius: 0;
      height: 300px !important;
      width: 100%;
    }

    .case-gallery > .case-image:first-child {
      display: block !important;
    }

    .photo-counter { display: none !important; }

    .case-info { padding: 1.5rem 1.25rem 2rem; }
    .case-info h3 { font-size: 1.4rem; }
    .case-description { -webkit-line-clamp: 3; font-size: 0.88rem; }
  }

  @media (max-width: 480px) {
    .case-gallery { height: 260px; }
    .portfolio-nav-btn { width: 44px; height: 44px; }
    .portfolio-nav-btn svg { width: 16px; height: 16px; }
    .portfolio-pagination :global(.swiper-pagination-bullet) {
      width: 8px !important;
      height: 8px !important;
      margin: 0 3px !important;
    }
    .portfolio-pagination :global(.swiper-pagination-bullet-active) {
      width: 22px !important;
    }

    .modal-gallery { height: 220px; }
    .modal-body { padding: 1.25rem 1.25rem 1.5rem; }
    .portfolio-modal-content h2 { font-size: 1.4rem; }
    .modal-gallery-arrow { width: 34px; height: 34px; }
  }

  /* ==== Модалка: только основное (первое) фото ==== */
  .modal-gallery {
    position: relative;
    width: 100%;
    height: 260px;
    overflow: hidden;
    background: #0f0f12;
  }
  .modal-gallery-track {
    display: block;
    height: 100%;
    overflow: hidden;
  }
  .modal-gallery-slide {
    height: 100%;
  }
  .modal-gallery-slide:not(:first-child) {
    display: none !important;
  }
  .modal-gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .modal-gallery-arrow,
  .modal-gallery-indicator,
  .modal-gallery::after {
    display: none !important;
  }
  .modal-gallery .modal-tag {
    top: 0.9rem;
    left: 0.9rem;
  }
  
  /* ==== Модалка: большое фото ==== */
  .portfolio-modal-content .modal-gallery {
    height: 340px;
    background: #0f0f12;
    overflow: hidden;
    position: relative;
  }
  .portfolio-modal-content .modal-gallery-track {
    display: block !important;
    will-change: transform;
  }
  .portfolio-modal-content .modal-gallery-slide {
    display: block !important;
    width: 100% !important;
    height: 340px;
    overflow: hidden;
    flex: initial !important;
    scroll-snap-align: none !important;
  }
  .portfolio-modal-content .modal-gallery-slide img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }
  .portfolio-modal-content .modal-gallery-arrow,
  .portfolio-modal-content .modal-gallery-indicator,
  .portfolio-modal-content .modal-gallery::after {
    display: none !important;
  }
  .portfolio-modal-content .modal-gallery .modal-tag {
    top: 1rem;
    left: 1rem;
  }
  @media (max-width: 900px) {
    .portfolio-modal-content .modal-gallery {
      height: auto;
      min-height: 200px;
      max-height: 65vh;
      overflow-y: auto;
      overflow-x: hidden;
      background: #0f0f12;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .portfolio-modal-content .modal-gallery::-webkit-scrollbar { display: none; }
    .portfolio-modal-content .modal-gallery-track {
      display: block !important;
      transform: none !important;
      transition: none !important;
    }
    .portfolio-modal-content .modal-gallery-slide {
      display: block !important;
      width: 100% !important;
      height: auto !important;
      flex: initial !important;
      overflow: hidden;
      scroll-snap-align: unset !important;
    }
    .portfolio-modal-content .modal-gallery-slide img {
      width: 100% !important;
      height: auto !important;
      object-fit: initial !important;
      display: block !important;
      background: #0f0f12;
    }
    .portfolio-modal-content .modal-gallery::after { display: none !important; }
  }

.card-location,
.case-meta span,
.modal-location {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
