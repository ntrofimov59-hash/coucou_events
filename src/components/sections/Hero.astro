}[lang as "ru" | "eng" | "esp" | "arm"] || {
  eyebrow: "Coucou Events",
  slides: [
    {
      titleHtml: "АРЕНДА<br />ШАТРОВ",
      titleText: "АРЕНДА ШАТРОВ",
      subtitle:
        "Премиальные шатры и мобильные конструкции для мероприятий любого масштаба",
      image:
        "/images/hero/hero-main-1-tents.webp",
    },
    {
      titleHtml: "КОРПОРАТИВЫ<br />МИРОВОГО УРОВНЯ",
      titleText: "КОРПОРАТИВЫ МИРОВОГО УРОВНЯ",
      subtitle: "Тимбилдинг, гала-ужины и деловые мероприятия в 14 странах",
      image:
        "/images/hero/hero-main-2-corporate.webp",
    },
    {
      titleHtml: "ЧАСТНЫЕ<br />ПРАЗДНИКИ",
      titleText: "ЧАСТНЫЕ ПРАЗДНИКИ",
