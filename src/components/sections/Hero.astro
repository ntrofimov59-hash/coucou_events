      },
      {
        titleHtml: "CORPORATIVOS<br />DE CLASE MUNDIAL",
        titleText: "CORPORATIVOS DE CLASE MUNDIAL",
        subtitle:
          "Team building, cenas de gala y eventos de negocios en 14 países",
