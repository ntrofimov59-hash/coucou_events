---
import { getCollection } from "astro:content";

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const { lang: paramLang, locale } = Astro.params;
const lang = propLang || paramLang || locale || "ru";

const entries = await getCollection("testimonials");

const sorted = [...entries].sort(
  (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
);

const defaultRoleMap: Record<string, string> = {
  ru: "Клиент",
  eng: "Client",
  esp: "Cliente",
  arm: "Հաճախորդ",
};

const testimonialsList = sorted.map((entry, idx) => {
  const data = entry.data;

  let currentAuthor = data.author;
  if (lang === "eng" && data.authorEn) currentAuthor = data.authorEn;
  if (lang === "esp" && data.authorEsp) currentAuthor = data.authorEsp;
  if (lang === "arm" && data.authorArm) currentAuthor = data.authorArm;

  let currentText = data.text;
  if (lang === "eng" && data.textEn) currentText = data.textEn;
  if (lang === "esp" && data.textEsp) currentText = data.textEsp;
  if (lang === "arm" && data.textArm) currentText = data.textArm;

  let currentEvent = data.event;
  if (lang === "eng" && data.eventEn) currentEvent = data.eventEn;
  if (lang === "esp" && data.eventEsp) currentEvent = data.eventEsp;
  if (lang === "arm" && data.eventArm) currentEvent = data.eventArm;

  return {
    id: idx,
    name: currentAuthor,
    role: currentEvent || defaultRoleMap[lang] || "Клиент",
    content: currentText,
    avatar: `https://i.pravatar.cc/150?u=${entry.id}`,
    rating: data.rating,
    platform: data.platform,
  };
});

const t = {
  ru: {
    title: "Что говорят наши клиенты",
    subtitle:
      "Истории живых эмоций, доверия и безупречно реализованных проектов.",
    emptyText: "Отзывы пока не добавлены.",
  },
  eng: {
    title: "What Our Clients Say",
    subtitle:
      "Stories of genuine emotions, trust, and flawlessly executed projects.",
    emptyText: "No reviews added yet.",
  },
  esp: {
    title: "Lo que dicen nuestros clientes",
    subtitle:
      "Historias de emociones reales, confianza y proyectos ejecutados.",
    emptyText: "Aún no hay reseñas agregadas.",
  },
  arm: {
    title: "Ինչ են ասում մեր հաճախորդները",
    subtitle: "Իրական էմոցիաների, վստահության և կատարյալ իրականացված ծրագրերի:",
    emptyText: "Կարծիքներ դեռ ավելացված չեն:",
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  title: "Что говорят наши клиенты",
  subtitle:
    "Истории живых эмоций, доверия и безупречно реализованных проектов.",
  emptyText: "Отзывы пока не добавлены.",
};
---

<section
  id="testimonials"
  class="py-20 bg-zinc-950 text-white border-t border-zinc-900 w-full block"
  lang={lang}
>
  <div class="max-w-6xl mx-auto px-6">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6"
    >
      <div class="text-center md:text-left">
        <h2
          class="text-3xl md:text-4xl font-serif tracking-tight text-white mb-3"
        >
          {t.title}
        </h2>
        <p class="text-sm md:text-base text-zinc-400 font-light max-w-xl">
          {t.subtitle}
        </p>
      </div>

      <!-- Кнопки управления (на десктопе всегда flex, на мобилках скрыты) -->
      {
        testimonialsList.length > 0 && (
          <div class="desktop-arrows-wrapper">
            <button
              id="prevTestimonial"
              class="w-12 h-12 rounded-full border border-zinc-800 bg-zinc-900 flex items-center justify-center text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors cursor-pointer"
              aria-label="Previous"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              id="nextTestimonial"
              class="w-12 h-12 rounded-full border border-zinc-800 bg-zinc-900 flex items-center justify-center text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors cursor-pointer"
              aria-label="Next"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        )
      }
    </div>

    {
      testimonialsList.length === 0 ? (
        <div class="text-center py-12 text-zinc-400">
          <p>{t.emptyText}</p>
        </div>
      ) : (
        <div id="testimonialsTrack" class="testimonials-container">
          {testimonialsList.map((item) => (
            <div class="testimonial-card">
              <span class="absolute top-4 right-5 md:top-5 md:right-6 text-4xl md:text-5xl font-serif text-zinc-800 pointer-events-none">
                “
              </span>

              <p class="text-zinc-300 text-xs sm:text-sm md:text-base leading-relaxed font-light mb-6 md:mb-8 relative z-10 italic">
                {item.content}
              </p>

              <div class="flex items-center space-x-3 md:space-x-4 border-t border-zinc-800/60 pt-4 md:pt-5">
                <img
                  src={item.avatar}
                  alt={item.name}
                  class="w-9 h-9 md:w-12 md:h-12 rounded-full object-cover border border-zinc-700 bg-zinc-800"
                />
                <div>
                  <h4 class="text-white font-medium text-xs md:text-sm tracking-wide">
                    {item.name}
                  </h4>
                  <p class="text-[11px] md:text-xs text-zinc-500 font-light mt-0.5">
                    {item.role}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  const track = document.getElementById(
    "testimonialsTrack",
  ) as HTMLDivElement | null;
  const prevBtn = document.getElementById(
    "prevTestimonial",
  ) as HTMLButtonElement | null;
  const nextBtn = document.getElementById(
    "nextTestimonial",
  ) as HTMLButtonElement | null;

  if (track && prevBtn && nextBtn) {
    prevBtn.addEventListener("click", () => {
      const cardWidth =
        track.querySelector(".testimonial-card")?.clientWidth || 350;
      track.scrollBy({ left: -(cardWidth + 24), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      const cardWidth =
        track.querySelector(".testimonial-card")?.clientWidth || 350;
      track.scrollBy({ left: cardWidth + 24, behavior: "smooth" });
    });
  }
</script>

<style>
  /* Контейнер ленты отзывов */
  .testimonials-container {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory; /* Жесткая привязка */
    padding-bottom: 1rem;
    scrollbar-width: none; /* Firefox */
  }

  .testimonials-container::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
  }

  /* Карточка отзыва */
  .testimonial-card {
    flex: 0 0 100%; /* На мобилках карточка занимает ровно 100 ширины экрана */
    scroll-snap-align: start; /* Резкая фиксация по началу карточки */
    background: rgba(24, 24, 27, 0.4);
    border: 1px solid rgba(39, 39, 42, 0.8);
    border-radius: 1.25rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  /* Управление видимостью стрелок */
  .desktop-arrows-wrapper {
    display: none; /* По умолчанию скрыты (на мобилках) */
  }

  /* Планшеты и десктоп (от 768px и выше) */
  @media (min-width: 768px) {
    .testimonial-card {
      flex: 0 0 380px; /* На десктопе фиксированная ширина карточки */
      padding: 2rem;
      border-radius: 1.5rem;
    }

    .desktop-arrows-wrapper {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
  }
</style>
