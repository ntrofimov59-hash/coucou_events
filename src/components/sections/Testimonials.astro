---
import { getCollection } from "astro:content";

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const { lang: paramLang, locale } = Astro.params;
const lang = propLang || paramLang || locale || "ru";

// Получаем все отзывы
const entries = await getCollection("testimonials");

const sorted = [...entries].sort(
  (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
);

// Локализация роли по умолчанию в зависимости от языка
const defaultRoleMap: Record<string, string> = {
  ru: "Клиент",
  eng: "Client",
  esp: "Cliente",
  arm: "Հաճախորդ",
};

// Маппинг ключей языка для авторов и событий, если вы их заполнили мультиязычно
const testimonialsList = sorted.map((entry, idx) => {
  const data = entry.data;

  // Динамический выбор перевода текста и автора в зависимости от активного языка
  let currentAuthor = data.author;
  if (lang === "eng" && data.authorEn) currentAuthor = data.authorEn;
  if (lang === "esp" && data.authorEsp) currentAuthor = data.authorEsp;
  if (lang === "arm" && data.authorArm) currentAuthor = data.authorArm;

  let currentText = data.text;
  if (lang === "eng" && data.textEn) currentText = data.textEn;
  if (lang === "esp" && data.textEsp) currentText = data.textEsp;
  if (lang === "arm" && data.textArm) currentText = data.textArm;

  let currentEvent = data.event;
  if (lang === "eng" && data.eventEn) currentEvent = data.eventEn;
  if (lang === "esp" && data.eventEsp) currentEvent = data.eventEsp;
  if (lang === "arm" && data.eventArm) currentEvent = data.eventArm;

  return {
    id: idx,
    name: currentAuthor,
    role: currentEvent || defaultRoleMap[lang] || "Клиент",
    content: currentText,
    avatar: `https://i.pravatar.cc/150?u=${entry.id}`,
    rating: data.rating,
    platform: data.platform,
  };
});

// Переводы текстов интерфейса секции
const t = {
  ru: {
    title: "Что говорят наши клиенты",
    subtitle:
      "Истории живых эмоций, доверия и безупречно реализованных проектов по всему миру.",
    emptyText: "Отзывы пока не добавлены.",
    seoKeywords:
      "отзывы о мероприятиях, отзывы клиентов, ивент агентство отзывы, впечатления клиентов",
  },
  eng: {
    title: "What Our Clients Say",
    subtitle:
      "Stories of genuine emotions, trust, and flawlessly executed projects around the world.",
    emptyText: "No reviews added yet.",
    seoKeywords:
      "event reviews, client feedback, event agency testimonials, customer impressions",
  },
  esp: {
    title: "Lo que dicen nuestros clientes",
    subtitle:
      "Historias de emociones reales, confianza y proyectos ejecutados a la perfección en todo el mundo.",
    emptyText: "Aún no hay reseñas agregadas.",
    seoKeywords:
      "reseñas de eventos, opiniones de clientes, testimonios agencia de eventos",
  },
  arm: {
    title: "Ինչ են ասում մեր հաճախորդները",
    subtitle:
      "Իրական էմոցիաների, վստահության և աշխարհով մեկ կատարյալ իրականացված ծրագրերի պատմություններ:",
    emptyText: "Կարծիքներ դեռ ավելացված չեն:",
    seoKeywords:
      "կարծիքներ միջոցառումների մասին, հաճախորդների կարծիքներ, իվենթ գործակալություն",
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  title: "Что говорят наши клиенты",
  subtitle:
    "Истории живых эмоций, доверия и безупречно реализованных проектов по всему миру.",
  emptyText: "Отзывы пока не добавлены.",
  seoKeywords: "отзывы о мероприятиях, отзывы клиентов, ивент агентство отзывы",
};
---

<!-- SEO ключевые слова для индексации -->
<meta name="keywords" content={t.seoKeywords} />

<section
  id="testimonials"
  class="py-20 bg-zinc-950 text-white border-t border-zinc-900 w-full block"
  lang={lang}
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2
        class="text-3xl md:text-4xl font-serif tracking-tight text-white mb-3"
      >
        {t.title}
      </h2>
      <p
        class="text-sm md:text-base text-zinc-400 font-light max-w-2xl mx-auto"
      >
        {t.subtitle}
      </p>
    </div>

    {
      testimonialsList.length === 0 ? (
        <div class="text-center py-12 text-zinc-400">
          <p>{t.emptyText}</p>
        </div>
      ) : (
        <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-6 scrollbar-thin scrollbar-thumb-zinc-800">
          {testimonialsList.map((item) => (
            <div class="min-w-[300px] md:min-w-[380px] max-w-[400px] flex-shrink-0 snap-start bg-zinc-900/40 p-6 md:p-8 rounded-3xl border border-zinc-800/80 flex flex-col justify-between shadow-xl relative group">
              <span class="absolute top-5 right-6 text-5xl font-serif text-zinc-800 group-hover:text-red-500/20 transition-colors pointer-events-none">
                “
              </span>

              <p class="text-zinc-300 text-sm md:text-base leading-relaxed font-light mb-8 relative z-10 italic">
                {item.content}
              </p>

              <div class="flex items-center space-x-4 border-t border-zinc-800/60 pt-5">
                <img
                  src={item.avatar}
                  alt={item.name}
                  class="w-10 h-10 md:w-12 md:h-12 rounded-full object-cover border border-zinc-700 bg-zinc-800"
                />
                <div>
                  <h4 class="text-white font-medium text-sm tracking-wide">
                    {item.name}
                  </h4>
                  <p class="text-xs text-zinc-500 font-light mt-0.5">
                    {item.role}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
