---
import { getCollection } from "astro:content";
import { SITE_URL, SITE_NAME, CONTACT } from "@/config/site";

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const { lang: paramLang, locale } = Astro.params;
const lang = propLang || paramLang || locale || "ru";

const entries = await getCollection("testimonials");

const sorted = [...entries].sort(
  (a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0),
);

const defaultRoleMap: Record<string, string> = {
  ru: "Клиент",
  eng: "Client",
  esp: "Cliente",
  arm: "Հաճախորդ",
};

const testimonialsList = sorted.map((entry, idx) => {
  const data = entry.data;
  let currentAuthor = data.author;
  if (lang === "eng" && data.authorEn) currentAuthor = data.authorEn;
  if (lang === "esp" && data.authorEsp) currentAuthor = data.authorEsp;
  if (lang === "arm" && data.authorArm) currentAuthor = data.authorArm;
  let currentText = data.text;
  if (lang === "eng" && data.textEn) currentText = data.textEn;
  if (lang === "esp" && data.textEsp) currentText = data.textEsp;
  if (lang === "arm" && data.textArm) currentText = data.textArm;
  let currentEvent = data.event;
  if (lang === "eng" && data.eventEn) currentEvent = data.eventEn;
  if (lang === "esp" && data.eventEsp) currentEvent = data.eventEsp;
  if (lang === "arm" && data.eventArm) currentEvent = data.eventArm;
  return {
    id: idx,
    name: currentAuthor,
    role: currentEvent || defaultRoleMap[lang] || "Клиент",
    content: currentText,
    initials: String(currentAuthor)
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((w) => w[0])
      .join("")
      .toUpperCase(),
    rating: data.rating,
    platform: data.platform,
  };
});

const ratedItems = sorted.filter((e) => typeof e.data.rating === "number");
const avgRating = ratedItems.length
  ? ratedItems.reduce((sum, e) => sum + e.data.rating, 0) / ratedItems.length
  : null;

const reviewJsonLd =
  avgRating && testimonialsList.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": `${SITE_URL}/#organization`,
        name: SITE_NAME,
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: Number(avgRating.toFixed(1)),
          reviewCount: testimonialsList.length,
          bestRating: 5,
        },
        review: sorted.slice(0, 10).map((e) => ({
          "@type": "Review",
          author: { "@type": "Person", name: e.data.author },
          reviewRating: {
            "@type": "Rating",
            ratingValue: e.data.rating,
            bestRating: 5,
          },
          reviewBody: e.data.text,
          datePublished: e.data.date
            ? e.data.date.toISOString().slice(0, 10)
            : undefined,
        })),
      }
    : null;

const t = {
  ru: {
    title: "Почему нам можно доверять",
    subtitle:
      "Мы молодая команда с базой в Ереване. Вместо выдуманных отзывов — прозрачные правила работы, которые можно проверить с первого звонка.",
    emptyText: "Отзывы появятся здесь по мере реализованных проектов.",
    cta: "Обсудить ваше мероприятие",
    promises: [
      {
        title: "Честная смета",
        text: "Фиксируем состав и цены до старта. Без скрытых наценок и «сюрпризов» в день события.",
      },
      {
        title: "Личное сопровождение",
        text: "Один ответственный менеджер от первого звонка до демонтажа. Не передаём вас между отделами.",
      },
      {
        title: "Сеть подрядчиков",
        text: "Работаем с проверенными поставщиками в 15 городах. Вы получаете единую точку контакта.",
      },
      {
        title: "Договор и сроки",
        text: "Работаем по договору. Сроки монтажа и сдачи фиксируем письменно.",
      },
    ],
  },
  eng: {
    title: "Why you can trust us",
    subtitle:
      "We're a new team based in Yerevan. Instead of invented reviews — clear working rules you can verify from the first call.",
    emptyText: "Reviews will appear here as projects are completed.",
    cta: "Discuss your event",
    promises: [
      {
        title: "Honest quote",
        text: "Scope and prices locked before we start. No hidden markups or day-of surprises.",
      },
      {
        title: "Personal care",
        text: "One dedicated manager from first call to teardown.",
      },
      {
        title: "Partner network",
        text: "Vetted suppliers in 15 cities. You get a single point of contact.",
      },
      {
        title: "Contract & deadlines",
        text: "We work under contract. Dates are fixed in writing.",
      },
    ],
  },
  esp: {
    title: "Por qué puedes confiar en nosotros",
    subtitle:
      "Somos un equipo nuevo con base en Ereván. En lugar de reseñas inventadas — reglas claras.",
    emptyText: "Las reseñas aparecerán aquí a medida que se completen proyectos.",
    cta: "Hablar de tu evento",
    promises: [
      { title: "Presupuesto honesto", text: "Alcance y precios fijados antes de empezar." },
      { title: "Acompañamiento personal", text: "Un gestor dedicado de principio a fin." },
      { title: "Red de proveedores", text: "Socios verificados en 15 ciudades." },
      { title: "Contrato y plazos", text: "Trabajamos con contrato y fechas por escrito." },
    ],
  },
  arm: {
    title: "Ինչու կարելի է վստահել մեզ",
    subtitle: "Մենք նոր թիմ ենք՝ բազայով Երևանում։ Հորինված կարծիքների փոխարեն՝ թափանցիկ կանոններ։",
    emptyText: "Կարծիքները կհայտնվեն այստեղ՝ նախագծերի իրականացմանը զուգահեռ։",
    cta: "Քննարկել ձեր միջոցառումը",
    promises: [
      { title: "Ազնիվ նախահաշիվ", text: "Ծավալն ու գները ֆիքսում ենք մինչև մեկնարկը։" },
      { title: "Անհատական ուղեկցում", text: "Մեկ պատասխանատու մենեջեր՝ սկզբից մինչև վերջ։" },
      { title: "Գործընկերների ցանց", text: "Ստուգված մատակարարներ 15 քաղաքում։" },
      { title: "Պայմանագիր և ժամկետներ", text: "Աշխատում ենք պայմանագրով։" },
    ],
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  title: "Почему нам можно доверять",
  subtitle: "Мы молодая команда с базой в Ереване.",
  emptyText: "Отзывы появятся здесь по мере реализованных проектов.",
  cta: "Обсудить ваше мероприятие",
  promises: [],
};

const whatsappHref = CONTACT?.whatsappHref || "https://wa.me/37455385943";
---

<section
  id="testimonials"
  class="py-20 bg-zinc-950 text-white border-t border-zinc-900 w-full block"
  lang={lang}
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center md:text-left mb-12 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-serif tracking-tight text-white mb-3">
        {t.title}
      </h2>
      <p class="text-sm md:text-base text-zinc-400 font-light">{t.subtitle}</p>
    </div>

    {
      testimonialsList.length === 0 ? (
        <div class="trust-grid">
          {t.promises.map((p) => (
            <div class="trust-card">
              <h3 class="trust-card__title">{p.title}</h3>
              <p class="trust-card__text">{p.text}</p>
            </div>
          ))}
          <div class="trust-cta">
            <a href={whatsappHref} class="trust-cta__btn" target="_blank" rel="noopener">
              {t.cta}
            </a>
            <p class="trust-cta__note">{t.emptyText}</p>
          </div>
        </div>
      ) : (
        <div id="testimonialsTrack" class="testimonials-container">
          {testimonialsList.map((item) => (
            <div class="testimonial-card">
              <p class="text-zinc-300 font-light text-sm md:text-base leading-relaxed mb-6">
                “{item.content}”
              </p>
              <div class="flex items-center gap-3 mt-auto">
                <div class="w-10 h-10 rounded-full bg-teal-900/60 border border-teal-800/50 flex items-center justify-center text-xs font-medium text-teal-100 shrink-0">
                  {item.initials}
                </div>
                <div>
                  <h4 class="text-white font-medium text-xs md:text-sm tracking-wide">{item.name}</h4>
                  <p class="text-[11px] md:text-xs text-zinc-500 font-light mt-0.5">{item.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

{reviewJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(reviewJsonLd)} />
)}

<style>
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .trust-grid { grid-template-columns: 1fr 1fr; }
  }
  .trust-card {
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: rgba(24, 24, 27, 0.6);
    border: 1px solid rgba(63, 63, 70, 0.5);
  }
  .trust-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #5eead4;
    margin-bottom: 0.5rem;
  }
  .trust-card__text {
    font-size: 0.9rem;
    line-height: 1.55;
    color: #a1a1aa;
    font-weight: 300;
  }
  .trust-cta {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 0 0.5rem;
  }
  .trust-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    background: #0d9488;
    color: #fff;
    font-weight: 550;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .trust-cta__btn:hover { background: #0f766e; }
  .trust-cta__note { font-size: 0.8rem; color: #71717a; text-align: center; }
  .testimonials-container {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .testimonial-card {
    flex: 0 0 min(100%, 360px);
    scroll-snap-align: start;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: rgba(24, 24, 27, 0.7);
    border: 1px solid rgba(63, 63, 70, 0.45);
    display: flex;
    flex-direction: column;
  }
</style>
