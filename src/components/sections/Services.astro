---
import { getCollection } from "astro:content";
import { formatPriceFrom } from "@/data/pricingData";

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const { lang: paramLang, locale } = Astro.params;
const currentLang = propLang || paramLang || locale || "ru";

const entries = await getCollection(
  "services",
  ({ id, data }) =>
    (!currentLang || id.startsWith(`${currentLang}/`)) &&
    data.published !== false,
);

const fallbackImg = "/images/services/service-tents-card.webp";

const servicesList = entries
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 4)
  .map((entry) => {
    const cleanId = entry.id.includes("/")
      ? entry.id
          .split("/")
          .slice(1)
          .join("/")
          .replace(/\.(mdx|md)$/, "")
      : entry.id.replace(/\.(mdx|md)$/, "");

    const prefix = `/${currentLang}`;
    const serviceUrl = `${prefix}/services/${cleanId}`;

    return {
      id: cleanId,
      url: serviceUrl,
      title: entry.data.title,
      desc: entry.data.description,
      price: formatPriceFrom(cleanId, currentLang),
      time: formatPriceFrom(cleanId, currentLang),
      label: entry.data.title,
      img: entry.data.images?.[0] || fallbackImg,
    };
  });

const t = {
  ru: {
    tag: "Создайте идеальное событие прямо сейчас",
    description:
      "Выберите готовое премиальное решение или скомпонуйте индивидуальный пакет услуг. Доверьте всю сложную рутину профессионалам команды Coucou и наслаждайтесь безупречным результатом.",
    emptyText: "Услуги временно недоступны. Проверьте папку контента.",
    calcText: "Рассчитать смету",
    timeLabel: "Формат / Сроки",
    priceLabel: "Стоимость",
  },
  eng: {
    tag: "Create your ideal event right now",
    description:
      "Choose a ready-made premium solution or assemble an individual service package. Trust all the routine to Coucou's professionals and enjoy the flawless result.",
    emptyText:
      "Services are temporarily unavailable. Please check the content folder.",
    calcText: "Calculate estimate",
    timeLabel: "Format / Timeline",
    priceLabel: "Price",
  },
  esp: {
    tag: "Crea tu evento ideal ahora mismo",
    description:
      "Elige una solución prémium lista o diseña un paquete de servicios a medida. Confía la rutina a los profesionales de Coucou y disfruta de un resultado impecable.",
    emptyText:
      "Servicios temporalmente no disponibles. Comprueba la carpeta de contenido.",
    calcText: "Calcular presupuesto",
    timeLabel: "Formato / Plazos",
    priceLabel: "Precio",
  },
  arm: {
    tag: "Ստեղծեք ձեր կատարյալ միջոցառումը հենց հիմա",
    description:
      "Ընտրեք պատրաստի պրեմիում լուծում կամ հավաքեք անհատական ծառայությունների փաթեթ: Վստահեք ամբողջ բարդ աշխատանքը Coucou-ի մասնագետներին և վայելեք անթերի արդյունքը:",
    emptyText: "Ծառայությունները ժամանակավորապես անհասանելի են:",
    calcText: "Հաշվարկել նախահաշիվը",
    timeLabel: "Ձևաչափ / Ժամկետներ",
    priceLabel: "Արժեք",
  },
}[currentLang as "ru" | "eng" | "esp" | "arm"] || {
  tag: "Создайте идеальное событие прямо сейчас",
  description:
    "Выберите готовое премиальное решение или скомпонуйте индивидуальный пакет услуг.",
  emptyText: "Услуги временно недоступны.",
  calcText: "Рассчитать смету",
  timeLabel: "Формат / Сроки",
  priceLabel: "Стоимость",
};

const ACCENT = "#e63946";
---

<section
  id="services"
  class="services-section py-24 bg-zinc-950 text-white overflow-hidden w-full block"
  lang={currentLang}
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2
        class="text-4xl md:text-5xl font-serif tracking-tight text-white mb-4"
      >
        {t.tag}
      </h2>
      <p class="text-base md:text-lg text-zinc-300 font-light leading-relaxed">
        {t.description}
      </p>
    </div>

    {
      servicesList.length === 0 ? (
        <div class="text-center py-12 text-zinc-400">
          <p>{t.emptyText}</p>
        </div>
      ) : (
        <>
          {/* МОБИЛЬНАЯ КАРУСЕЛЬ */}
          <div class="block lg:hidden mobile-carousel-wrapper">
            <div class="mobile-carousel-track">
              {servicesList.map((service) => (
                <a
                  href={service.url}
                  class="mobile-service-card bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden flex flex-col justify-between group shadow-xl"
                >
                  <div class="relative h-48 overflow-hidden bg-zinc-800">
                    <img
                      src={service.img}
                      alt={service.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      width="400"
                      height="240"
                    />
                    <div class="absolute top-3 right-3 bg-black/70 backdrop-blur-md px-3 py-1 rounded-full text-xs font-medium text-white border border-white/10">
                      {service.price}
                    </div>
                  </div>
                  <div class="p-5 flex flex-col flex-grow justify-between">
                    <div>
                      <h3 class="text-xl font-serif text-white mb-2 group-hover:text-[#e63946] transition-colors">
                        {service.title}
                      </h3>
                      <p class="text-zinc-400 text-xs leading-relaxed line-clamp-3 font-light mb-4">
                        {service.desc}
                      </p>
                    </div>
                    <div class="flex items-center justify-between text-xs font-medium text-white pt-3 border-t border-zinc-800">
                      <span class="text-[#e63946]">{t.calcText}</span>
                      <span class="w-7 h-7 rounded-full bg-zinc-800 group-hover:bg-[#e63946] flex items-center justify-center transition-colors">
                        →
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {/* ДЕСКТОП: слева превью, справа список */}
          <div class="hidden lg:grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
            {/* СЛЕВА — превью */}
            <div class="bg-zinc-900/40 p-8 rounded-3xl border border-zinc-800/80 h-[540px] flex flex-col justify-between relative shadow-2xl backdrop-blur-sm overflow-hidden">
              <div
                id="preview-container"
                class="h-full flex flex-col justify-between transition-opacity duration-300"
              >
                <div class="space-y-4">
                  <h3
                    id="details-title"
                    class="text-3xl font-serif text-[#e63946] min-h-[2.5rem]"
                  >
                    {servicesList[0]?.title}
                  </h3>
                  <p
                    id="details-desc"
                    class="text-zinc-100 text-base leading-relaxed font-light line-clamp-3"
                  >
                    {servicesList[0]?.desc}
                  </p>
                  <div class="grid grid-cols-2 gap-6 pt-4 border-t border-zinc-800/60 text-sm">
                    <div>
                      <span class="block text-xs text-zinc-400 uppercase tracking-wider mb-1">
                        {t.timeLabel}
                      </span>
                      <strong id="details-time" class="font-normal text-white">
                        {servicesList[0]?.time}
                      </strong>
                    </div>
                    <div>
                      <span class="block text-xs text-zinc-400 uppercase tracking-wider mb-1">
                        {t.priceLabel}
                      </span>
                      <strong id="details-price" class="font-normal text-white">
                        {servicesList[0]?.price}
                      </strong>
                    </div>
                  </div>
                </div>

                <div class="relative rounded-2xl overflow-hidden bg-zinc-800 aspect-[16/10] flex flex-col justify-end group shadow-inner">
                  <img
                    id="details-img"
                    src={servicesList[0]?.img}
                    alt=""
                    class="object-cover w-full h-full absolute inset-0 transition-transform duration-700 scale-100"
                    width="640"
                    height="400"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent z-10" />
                  <div
                    id="details-img-label"
                    class="absolute bottom-0 left-0 right-0 p-4 text-left text-xs text-zinc-200 tracking-wide font-light z-20"
                  >
                    {servicesList[0]?.label}
                  </div>
                </div>
              </div>
            </div>

            {/* СПРАВА — названия услуг */}
            <div class="flex flex-col justify-center divide-y divide-zinc-800/60">
              {servicesList.map((service, index) => (
                <a
                  href={service.url}
                  class="service-item cursor-pointer py-6 transition-all duration-300 hover:pl-4 group flex items-center justify-between no-underline"
                  data-index={index}
                >
                  <div class="flex-grow pr-4 pointer-events-none">
                    <span class="service-title-text text-3xl font-light text-zinc-300 group-hover:text-[#e63946] transition-colors duration-300 block">
                      {index + 1}. {service.title}
                    </span>
                  </div>
                  <span class="text-zinc-600 group-hover:text-[#e63946] transition-colors duration-300 text-xl font-light p-2">
                    →
                  </span>
                </a>
              ))}
            </div>
          </div>
        </>
      )
    }
  </div>
</section>

<script define:vars={{ servicesList }}>
  document.addEventListener("DOMContentLoaded", () => {
    if (window.innerWidth < 1024) return;

    const previewContainer = document.getElementById("preview-container");
    const titleEl = document.getElementById("details-title");
    const descEl = document.getElementById("details-desc");
    const timeEl = document.getElementById("details-time");
    const priceEl = document.getElementById("details-price");
    const imgEl = document.getElementById("details-img");
    const labelEl = document.getElementById("details-img-label");

    if (!previewContainer || !titleEl) return;

    const items = document.querySelectorAll(".service-item");

    items.forEach((item) => {
      item.addEventListener("mouseenter", () => {
        const index = item.getAttribute("data-index");
        const service = servicesList[index];
        if (!service) return;

        previewContainer.style.opacity = "0.4";

        setTimeout(() => {
          titleEl.textContent = service.title;
          descEl.textContent = service.desc;
          timeEl.textContent = service.time;
          priceEl.textContent = service.price;
          imgEl.src = service.img;
          labelEl.textContent = service.label;
          previewContainer.style.opacity = "1";
        }, 150);
      });
    });
  });
</script>

<style>
  .mobile-carousel-wrapper {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    box-sizing: border-box;
  }

  .mobile-carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .mobile-carousel-track {
    display: flex;
    gap: 1rem;
    padding-bottom: 1rem;
  }

  .mobile-service-card img,
  .mobile-service-card .card-img {
    max-height: 180px;
    object-fit: cover;
    width: 100%;
  }
  .mobile-service-card {
    min-width: 280px;
    max-width: 300px;
    width: 78vw;
    flex-shrink: 0;
  }

  #preview-container {
    max-height: 420px;

    transition: opacity 0.2s ease-in-out;
  }

  /* Чуть мягче hover у списка */
  .service-item:focus-visible {
    outline: 2px solid #e63946;
    outline-offset: 4px;
    border-radius: 8px;
  }
</style>
