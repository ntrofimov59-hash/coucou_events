---
interface Props {
  lang?: string;
}

const { lang = "ru" } = Astro.props;

// Словари переводов и SEO-метаданных для секции "О нас" / About
const t = {
  ru: {
    heading: "О нас",
    description:
      "Coucou берёт на себя организацию мероприятия от первого звонка до последнего тоста — переговоры с площадками, подрядчиков, декор и логистику. Единственное, что нужно от вас, — выбрать дату и приехать гостем на собственный праздник, будь то Барселона, Бали, Тбилиси или ваш родной город.",
    stat1Text: "проведённых мероприятий",
    stat2Text: "лет на рынке",
    stat3Text: "городов мира",
    stat4Text: "поддержка на мероприятии",
    // SEO метаданные для возможного микроформата или заголовков
    seoKeywords:
      "организация мероприятий под ключ, ивент агентство Coucou, свадьбы за рубежом, корпоративы, премиум организация праздников",
  },
  eng: {
    heading: "About Us",
    description:
      "Coucou handles event planning from the first call to the final toast — venue negotiations, contractors, decor, and logistics. The only thing you need to do is pick a date and arrive as a guest at your own celebration, whether it's in Barcelona, Bali, Tbilisi, or your hometown.",
    stat1Text: "events successfully hosted",
    stat2Text: "years on the market",
    stat3Text: "global cities covered",
    stat4Text: "24/7 support during event",
    seoKeywords:
      "turnkey event planning, Coucou event agency, destination weddings, corporate events, premium celebration management",
  },
  esp: {
    heading: "Sobre Nosotros",
    description:
      "Coucou se encarga de la organización de eventos desde la primera llamada hasta el último brindis: negociaciones con recintos, proveedores, decoración y logística. Lo único que tienes que hacer es elegir una fecha y llegar como invitado a tu propia celebración, ya sea en Barcelona, Bali, Tbilisi o tu ciudad natal.",
    stat1Text: "eventos realizados",
    stat2Text: "años en el mercado",
    stat3Text: "ciudades del mundo",
    stat4Text: "asistencia 24/7 en el evento",
    seoKeywords:
      "organización de eventos llave en mano, agencia Coucou, bodas de destino, eventos corporativos, gestión prémium",
  },
  arm: {
    heading: "Մեր մասին",
    description:
      "Coucou-ն իր վրա է վերցնում միջոցառման կազմակերպումը առաջին զանգից մինչև վերջին կենացը՝ հարթակների հետ բանակցություններ, մատակարարներ, դեկոր և լոգիստիկա: Միակ բանը, որ պահանջվում է ձեզանից՝ ընտրել ամսաթիվը և գալ որպես հյուր ձեր սեփական տոնին՝ լինի դա Բարսելոնայում, Բալիում, Թբիլիսիում, թե ձեր հարազատ քաղաքում:",
    stat1Text: "անցկացված միջոցառում",
    stat2Text: "տարի շուկայում",
    stat3Text: "քաղաք ամբողջ աշխարհում",
    stat4Text: "24/7 աջակցություն միջոցառման ընթացքում",
    seoKeywords:
      "միջոցառումների կազմակերպում բանալին ձեռքին, Coucou գործակալություն, հարսանիքներ արտերկրում, կորպորատիվ միջոցառումներ",
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  heading: "О нас",
  description:
    "Coucou берёт на себя организацию мероприятия от первого звонка до последнего тоста — переговоры с площадками, подрядчиков, декор и логистику. Единственное, что нужно от вас, — выбрать дату и приехать гостем на собственный праздник, будь то Барселона, Бали, Тбилиси или ваш родной город.",
  stat1Text: "проведённых мероприятий",
  stat2Text: "лет на рынке",
  stat3Text: "городов мира",
  stat4Text: "поддержка на мероприятии",
  seoKeywords:
    "организация мероприятий под ключ, ивент агентство Coucou, свадьбы за рубежом",
};
---

<!-- SEO & Schema.org микроразметка для максимального поискового охвата секции "О нас" -->
<meta name="keywords" content={t.seoKeywords} />

<section id="about" class="py-24" lang={lang}>
  <div class="max-w-5xl mx-auto px-6 text-center">
    <h2 class="mb-8 u-fg font-serif text-4xl md:text-5xl">{t.heading}</h2>
    <p class="text-xl u-fg-soft leading-relaxed mb-12 font-light">
      {t.description}
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div
        class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/60 backdrop-blur-sm"
      >
        <div class="text-4xl font-bold text-teal-400 mb-2">150+</div>
        <div class="u-fg-soft text-sm">{t.stat1Text}</div>
      </div>
      <div
        class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/60 backdrop-blur-sm"
      >
        <div class="text-4xl font-bold text-teal-400 mb-2">8</div>
        <div class="u-fg-soft text-sm">{t.stat2Text}</div>
      </div>
      <div
        class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/60 backdrop-blur-sm"
      >
        <div class="text-4xl font-bold text-teal-400 mb-2">14</div>
        <div class="u-fg-soft text-sm">{t.stat3Text}</div>
      </div>
      <div
        class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/60 backdrop-blur-sm"
      >
        <div class="text-4xl font-bold text-teal-400 mb-2">24/7</div>
        <div class="u-fg-soft text-sm">{t.stat4Text}</div>
      </div>
    </div>
  </div>
</section>
