---
import { formatPriceFrom } from "@/data/pricingData";

export interface Props {
  service: any;
  lang?: string;
}

const { service, lang = "ru" } = Astro.props;
const { data, id } = service;

const slug = String(id)
  .replace(/\.(mdx|md)$/, "")
  .split("/")
  .pop()!;

const linkPrefix = `/${lang}/services/`;
const priceDisplay = formatPriceFrom(slug, lang);

const linkText =
  lang === "eng"
    ? "Go to calculator →"
    : lang === "esp"
      ? "Ir al calculador →"
      : lang === "arm"
        ? "Անցնել հաշվիչին →"
        : "Перейти к калькулятору →";
---

<a href={`${linkPrefix}${slug}#calculator`} class="glass service-card">
  {
    data.images && data.images.length > 0 && (
      <div class="service-card__image">
        <img src={data.images[0]} alt={data.title} loading="lazy" />
      </div>
    )
  }
  <div class="service-card__content">
    <h3>{data.title}</h3>
    <p>{data.description}</p>
    <span class="service-card__price">{priceDisplay}</span>
    {
      data.features && data.features.length > 0 && (
        <ul class="service-card__features">
          {data.features.slice(0, 3).map((feature: string) => (
            <li>✓ {feature}</li>
          ))}
        </ul>
      )
    }
    <span class="service-card__link">{linkText}</span>
  </div>
</a>

<style>
  .service-card {
    display: block;
    border-radius: 20px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    text-decoration: none;
    color: inherit;
  }
  .service-card:hover {
    transform: translateY(-6px);
  }
  .service-card__image {
    height: 200px;
    overflow: hidden;
  }
  .service-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-card__content {
    padding: 1.75rem;
  }
  .service-card__content h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.4rem;
    font-family: "Playfair Display", serif;
    color: var(--fg);
  }
  .service-card__content p {
    color: var(--fg-soft);
    font-size: 0.95rem;
    margin: 0 0 1rem 0;
    line-height: 1.5;
  }
  .service-card__price {
    display: inline-block;
    font-weight: 700;
    color: var(--accent-text);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }
  .service-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }
  .service-card__features li {
    font-size: 0.9rem;
    color: var(--fg-faint);
    margin-bottom: 0.3rem;
  }
  .service-card__link {
    font-weight: 600;
    color: var(--accent-text);
    display: inline-block;
  }
  .service-card:hover .service-card__link {
    text-decoration: underline;
  }
</style>
