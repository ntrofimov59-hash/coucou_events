---
import { CONTACT } from "@/config/site";

interface Props {
  lang?: string;
}

const { lang = "ru" } = Astro.props;

const labels = {
  ru: {
    whatsapp: "Написать в WhatsApp",
    booking: "Оставить заявку",
  },
  eng: {
    whatsapp: "Chat on WhatsApp",
    booking: "Submit request",
  },
  esp: {
    whatsapp: "Escribir por WhatsApp",
    booking: "Enviar solicitud",
  },
  arm: {
    whatsapp: "Գրել WhatsApp-ով",
    booking: "Թողնել հայտ",
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  whatsapp: "Написать в WhatsApp",
  booking: "Оставить заявку",
};

const prefix = `/${lang}`;
const waHref =
  CONTACT.whatsappHref ||
  (CONTACT.whatsapp
    ? `https://wa.me/${CONTACT.whatsapp.replace(/\D/g, "")}`
    : "#");
---

<div class="floating-actions" id="floatingActions" aria-label="Quick actions">
  <a
    href={waHref}
    class="fab fab-whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels.whatsapp}
    title={labels.whatsapp}
  >
    <svg
      viewBox="0 0 24 24"
      width="28"
      height="28"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
    <span class="fab-label">{labels.whatsapp}</span>
  </a>

  <a
    href={`${prefix}/booking`}
    class="fab fab-booking"
    aria-label={labels.booking}
    title={labels.booking}
  >
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path>
    </svg>
    <span class="fab-label">{labels.booking}</span>
  </a>
</div>

<script>
  // Кнопки прячутся при скролле вниз и появляются при скролле вверх.
  // Рядом с самым верхом страницы всегда показываем панель, чтобы она
  // не "мигала" на маленьких колебаниях скролла сразу после загрузки.
  const actions = document.getElementById("floatingActions");

  if (actions) {
    let lastScrollY = window.scrollY;
    let ticking = false;

    const SCROLL_THRESHOLD = 6; // игнорируем дрожание в несколько пикселей
    const TOP_OFFSET = 80; // всегда показываем панель у самого верха

    function updateVisibility() {
      // Явная проверка внутри замыкания: TypeScript не всегда протаскивает
      // сужение типа (null-check) из внешнего "if (actions)" через вложенную
      // функцию, поэтому проверяем ещё раз здесь же.
      if (!actions) {
        ticking = false;
        return;
      }

      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;

      if (currentScrollY <= TOP_OFFSET) {
        actions.classList.remove("is-hidden");
      } else if (Math.abs(delta) > SCROLL_THRESHOLD) {
        if (delta > 0) {
          // скроллим вниз — прячем
          actions.classList.add("is-hidden");
        } else {
          // скроллим вверх — показываем
          actions.classList.remove("is-hidden");
        }
        lastScrollY = currentScrollY;
      }

      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateVisibility);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .floating-actions {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-end;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s ease;
  }

  /* Скрытие при скролле вниз: уводим панель вниз за пределы экрана и
     гасим прозрачность, чтобы кнопки не перехватывали клики, пока их не видно */
  .floating-actions.is-hidden {
    transform: translateY(calc(100% + 2rem));
    opacity: 0;
    pointer-events: none;
  }

  .fab {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.35rem;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
  }

  .fab-whatsapp {
    background: #25d366;
  }

  .fab-whatsapp:hover {
    background: #1ebe57;
  }

  .fab-booking {
    background: #18181b;
  }

  .fab-booking:hover {
    background: #27272a;
  }

  .fab svg {
    flex-shrink: 0;
  }

  /* На мобильных устройствах убираем текст, но делаем сами кнопки чуть крупнее,
     чем раньше (менее "компактный" вид) */
  @media (max-width: 640px) {
    .fab {
      padding: 1.05rem;
      border-radius: 50%;
    }

    .fab-label {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .floating-actions {
      right: 0.85rem;
      bottom: 0.85rem;
    }
  }
</style>