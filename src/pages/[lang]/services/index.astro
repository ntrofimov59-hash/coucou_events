---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { formatPriceFrom } from "@/data/pricingData";

export function getStaticPaths() {
  return [
    { params: { lang: "ru" } },
    { params: { lang: "eng" } },
    { params: { lang: "esp" } },
    { params: { lang: "arm" } },
  ];
}

const { lang = "ru" } = Astro.params;

const entries = await getCollection(
  "services",
  ({ id, data }) => data.published !== false && id.startsWith(`${lang}/`),
);

const sortedServices = entries
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((entry) => {
    const slug = entry.id.includes("/")
      ? entry.id
          .split("/")
          .slice(1)
          .join("/")
          .replace(/\.(mdx|md)$/, "")
      : entry.id.replace(/\.(mdx|md)$/, "");

    return {
      id: slug,
      url: `/${lang}/services/${slug}?service=${slug}#calculator`,
      data: {
        title: entry.data.title,
        description: entry.data.description,
        price: formatPriceFrom(slug, lang),
        images: entry.data.images?.length
          ? entry.data.images
          : ["/images/services/service-tents-card.webp"],
        order: entry.data.order || 99,
        features: entry.data.features || [],
      },
    };
  });

const t = {
  ru: {
    badge: "Наши услуги",
    title: "Всё для вашего идеального праздника",
    calc: "Рассчитать смету",
    metaTitle: "Услуги — Организация мероприятий под ключ | Coucou",
    metaDesc:
      "Полный спектр премиум-услуг: аренда шатров, выездной кейтеринг, декор и организация мероприятий под ключ.",
  },
  eng: {
    badge: "Our Services",
    title: "Everything for your perfect celebration",
    calc: "Calculate estimate",
    metaTitle: "Services — Turnkey Event Organization | Coucou",
    metaDesc:
      "Full range of premium services: tent rental, catering, decor, and turnkey events.",
  },
  esp: {
    badge: "Nuestros Servicios",
    title: "Todo para tu celebración perfecta",
    calc: "Calcular presupuesto",
    metaTitle: "Servicios — Organización de Eventos | Coucou",
    metaDesc:
      "Gama completa de servicios prémium: alquiler de carpas, catering, decoración y eventos llave en mano.",
  },
  arm: {
    badge: "Մեր ծառայությունները",
    title: "Ամեն ինչ ձեր կատարյալ տոնի համար",
    calc: "Հաշվարկել նախահաշիվը",
    metaTitle: "Ծառայություններ — Միջոցառումների կազմակերպում | Coucou",
    metaDesc:
      "Պրեմիում ծառայությունների ամբողջական շրջանակ՝ վրանների վարձույթ, արտագնա քեյթերինգ, դեկոր և միջոցառումներ «բանալին ձեռքին»:",
  },
}[lang as "ru" | "eng" | "esp" | "arm"] || {
  badge: "Наши услуги",
  title: "Всё для вашего идеального праздника",
  calc: "Рассчитать смету",
  metaTitle: "Услуги — Организация мероприятий под ключ | Coucou",
  metaDesc:
    "Полный спектр премиум-услуг: аренда шатров, выездной кейтеринг, декор и организация мероприятий под ключ.",
};
---

<Layout
  title={t.metaTitle}
  description={t.metaDesc}
  lang={lang}
  currentPath={`/${lang}/services`}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="ru" href="/ru/services" />
    <link rel="alternate" hreflang="en" href="/eng/services" />
    <link rel="alternate" hreflang="es" href="/esp/services" />
    <link rel="alternate" hreflang="hy" href="/arm/services" />
    <link rel="alternate" hreflang="x-default" href="/ru/services" />
  </Fragment>

  <section class="services-catalog py-24 bg-zinc-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <div
          class="inline-block px-4 py-1.5 rounded-full bg-zinc-200/60 border border-zinc-300/50 text-xs text-zinc-700 uppercase tracking-widest mb-6"
        >
          {t.badge}
        </div>
        <h1
          class="text-5xl md:text-6xl font-serif tracking-tighter text-zinc-900"
        >
          {t.title}
        </h1>
      </div>

      <div class="services-container">
        <div class="services-grid">
          {
            sortedServices.map((service) => (
              <a
                href={service.url}
                class="service-card group bg-white rounded-2xl overflow-hidden border border-zinc-200/80 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col"
              >
                <div class="relative h-64 overflow-hidden bg-zinc-100 flex-shrink-0">
                  <img
                    src={service.data.images[0]}
                    alt={service.data.title}
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-medium text-zinc-900 shadow-sm">
                    {service.data.price}
                  </div>
                </div>

                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-2xl font-serif text-zinc-900 mb-3 group-hover:text-emerald-600 transition-colors">
                    {service.data.title}
                  </h3>
                  <p class="text-zinc-600 text-sm leading-relaxed mb-6 flex-grow font-light">
                    {service.data.description}
                  </p>

                  {service.data.features &&
                    service.data.features.length > 0 && (
                      <ul class="space-y-1.5 mb-6 text-xs text-zinc-500 border-t border-zinc-100 pt-4">
                        {service.data.features.slice(0, 3).map((feat) => (
                          <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
                            {feat}
                          </li>
                        ))}
                      </ul>
                    )}

                  <div class="flex items-center justify-between text-sm font-medium text-zinc-900 pt-4 border-t border-zinc-100 mt-auto">
                    <span class="group-hover:text-emerald-600 transition-colors">
                      {t.calc}
                    </span>
                    <span class="w-8 h-8 rounded-full bg-zinc-100 group-hover:bg-emerald-600 group-hover:text-white flex items-center justify-center transition-colors">
                      →
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-container {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    box-sizing: border-box;
  }
  .services-container::-webkit-scrollbar {
    display: none;
  }
  .services-grid {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 1rem;
  }
  .service-card {
    min-width: 290px;
    max-width: 320px;
    width: 82vw;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .services-container {
      width: 100%;
      margin-left: 0;
      padding-left: 0;
      padding-right: 0;
      overflow-x: visible;
    }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .service-card {
      min-width: auto;
      max-width: none;
      width: 100%;
    }
  }
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
