---
export const prerender = true;

import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import EventCalculator from "@/components/EventCalculator.astro";
import { formatPriceFrom } from "@/data/pricingData";

export async function getStaticPaths() {
  const services = await getCollection(
    "services",
    ({ data }) => data.published !== false,
  );

  return services.map((service) => {
    const parts = service.id.split("/");
    const lang = parts.length > 1 ? parts[0] : "ru";
    let slug = parts.length > 1 ? parts.slice(1).join("/") : parts[0];
    slug = slug.replace(/\.(mdx|md)$/, "");

    return {
      params: { lang, slug },
      props: { service },
    };
  });
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect("/404");
}

const { data, id } = service;
const { Content } = await render(service);

const parts = id.split("/");
const lang = parts.length > 1 ? parts[0] : "ru";
const slug = (parts.length > 1 ? parts.slice(1).join("/") : parts[0]).replace(
  /\.(mdx|md)$/,
  "",
);

const displayPrice = formatPriceFrom(slug, lang);

let bgImage = "";
if (data.images && Array.isArray(data.images) && data.images.length > 0) {
  bgImage = data.images[1] || data.images[0];
} else if ((data as any).image) {
  bgImage = (data as any).image;
}

const uiTexts = {
  ru: {
    priceLabel: "Стоимость реализации:",
    defaultPrice: "по запросу",
    bookBtn: "Забронировать дату",
    featuresTitle: "Что входит в стоимость услуги",
    seoTitle: "Частые запросы",
  },
  eng: {
    priceLabel: "Starting from:",
    defaultPrice: "Upon request",
    bookBtn: "Book a Date",
    featuresTitle: "What is included",
    seoTitle: "Popular searches",
  },
  esp: {
    priceLabel: "Desde:",
    defaultPrice: "A consultar",
    bookBtn: "Reservar fecha",
    featuresTitle: "Qué incluye el servicio",
    seoTitle: "Búsquedas populares",
  },
  arm: {
    priceLabel: "Արժեքը՝",
    defaultPrice: "Անհատական",
    bookBtn: "Ամրագրել ամսաթիվը",
    featuresTitle: "Ինչ է ներառված ծառայության մեջ",
    seoTitle: "Հաճախակի որոնվող հարցումներ",
  },
};

const t = uiTexts[lang as keyof typeof uiTexts] || uiTexts.ru;
---

<Layout
  title={`${data.title} | Coucou`}
  description={data.description}
  lang={lang}
  image={(data.images && data.images[1]) || bgImage || undefined}
>
  <section
    class="service-hero"
    style={bgImage ? `background-image: url('${bgImage}');` : ""}
  >
    <div class="hero-overlay"></div>
    <div class="hero-container">
      <h1>{data.title}</h1>
      <p class="service-lead">{data.description}</p>

      <div class="hero-action-bar">
        <div class="hero-price">
          <span>{t.priceLabel}</span>
          <strong>{displayPrice}</strong>
        </div>
        <a href={`/${lang}/booking?service=${slug}`} class="primary-btn"
          >{t.bookBtn}</a
        >
      </div>
    </div>
  </section>

  <div class="service-content-wrapper">
    <div class="content-container">
      <div class="mdx-article">
        <Content />
      </div>

      {
        data.features && data.features.length > 0 && (
          <div class="features-box">
            <h3>{t.featuresTitle}</h3>
            <div class="features-grid">
              {data.features.map((feature: string) => (
                <div class="feature-item">
                  <span class="check-icon">✓</span>
                  <span class="feature-text">
                    {typeof feature === "string"
                      ? feature
                      : JSON.stringify(feature)}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        data.searchKeywords && data.searchKeywords.length > 0 && (
          <div class="seo-box">
            <h4>{t.seoTitle}</h4>
            <div class="keywords-flex">
              {data.searchKeywords.map((kw: string) => (
                <span class="keyword-tag">{kw}</span>
              ))}
            </div>
          </div>
        )
      }

      <div id="calculator" class="calc-section">
        <EventCalculator
          serviceName={data.title}
          serviceId={slug}
          servicePrice={displayPrice}
          lang={lang}
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-hero {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 9rem 1.5rem 5rem 1.5rem;
    margin-top: -6rem;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    box-sizing: border-box;
    text-align: center;
    z-index: 1;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 9, 11, 0.45) 0%,
      rgba(9, 9, 11, 0.85) 75%,
      #09090b 100%
    );
    z-index: 1;
    pointer-events: none;
  }
  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
  }
  .service-hero h1 {
    font-size: 3.2rem;
    font-family: serif;
    color: #fff;
    margin-bottom: 1.2rem;
    font-weight: 400;
  }
  .service-lead {
    font-size: 1.25rem;
    color: #d4d4d8;
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto 2.5rem auto;
  }
  .hero-action-bar {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.25rem 2.25rem;
    border-radius: 16px;
    backdrop-filter: blur(12px);
    text-align: left;
  }
  .hero-price span {
    display: block;
    font-size: 0.75rem;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hero-price strong {
    font-size: 1.4rem;
    color: #fff;
  }
  .primary-btn {
    background: #10b981;
    color: white;
    padding: 0.8rem 2rem;
    border-radius: 12px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .service-content-wrapper {
    background-color: #09090b;
    padding: 3rem 0 6rem 0;
    color: #f4f4f5;
  }
  .content-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .mdx-article {
    color: #d4d4d8;
    line-height: 1.8;
    font-size: 1.1rem;
    margin-bottom: 3.5rem;
  }

  /* Принудительно задаем светлый цвет абсолютно всем элементам внутри MDX-статьи, перебивая любые внешние сбросы темы */
  .mdx-article :global(*) {
    color: #d4d4d8;
  }
  .mdx-article :global(h1),
  .mdx-article :global(h2),
  .mdx-article :global(h3),
  .mdx-article :global(h4),
  .mdx-article :global(h5),
  .mdx-article :global(h6),
  .mdx-article :global(strong),
  .mdx-article :global(b) {
    color: #ffffff;
  }
  .mdx-article :global(h2),
  .mdx-article :global(h3),
  .mdx-article :global(h4) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .mdx-article :global(p) {
    margin-bottom: 1.5rem;
  }
  .mdx-article :global(ul),
  .mdx-article :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .mdx-article :global(li) {
    margin-bottom: 0.5rem;
  }

  .features-box {
    background: #121215;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.25rem;
    margin-bottom: 3rem;
  }
  .features-box h3 {
    color: #ffffff;
    margin-bottom: 1.5rem;
    font-size: 1.4rem;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1rem 1.25rem;
    border-radius: 12px;
  }
  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-radius: 6px;
    font-weight: bold;
    font-size: 0.85rem;
  }
  .feature-text {
    font-size: 0.95rem;
    color: #e4e4e7;
  }
  .seo-box {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 2rem;
    margin-bottom: 3rem;
  }
  .seo-box h4 {
    color: #ffffff;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  .keywords-flex {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .keyword-tag {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    font-size: 0.85rem;
  }
  .calc-section {
    margin-top: 4rem;
  }
  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .hero-action-bar {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }
    .service-hero h1 {
      font-size: 2.2rem;
    }
  }
</style>
