// Цена контурного освещения привязана к базовой цене CALC_OPTIONS или декору
const lightingPriceUsd = CALC_OPTIONS.sound ? 150 : 150;
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="ru" href="/ru/configurator" />
    <link rel="alternate" hreflang="en" href="/eng/configurator" />
    <link rel="alternate" hreflang="es" href="/esp/configurator" />
    <link rel="alternate" hreflang="hy" href="/arm/configurator" />
    <link rel="alternate" hreflang="x-default" href="/ru/configurator" />
  </Fragment>

  <!--
    ВАЖНО: класс "no-fade-anim" исключает эту секцию из общего скролл-скрипта
    /scripts/scroll-animations.js. Этот скрипт навешивает transform на все
    <section> на странице для fade-up анимации, а transform на предке
    создаёт новый containing block и полностью ломает position: sticky у
    потомков (.summary-col). Не убирайте этот класс.
  -->
  <section
    class="configurator-page no-fade-anim bg-white text-zinc-900 min-h-screen font-sans py-16"
  >
    <div class="container max-w-6xl mx-auto px-6">
      <div
        class="text-xs uppercase tracking-widest text-zinc-400 mb-2 font-semibold"
      >
        {t.eyebrow}
      </div>
      <h1
        class="text-3xl md:text-4xl font-serif text-zinc-950 tracking-tight mb-3 font-extrabold"
      >
        {t.title}
      </h1>
      <p
        class="subtitle text-zinc-500 font-light max-w-2xl mb-12 text-sm md:text-base"
      >
        {t.subtitle}
      </p>

      <div class="configurator-grid">
        <div class="options space-y-4">
          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <div class="city-guests-row">
              <div class="city-guests-item">
                <h2
                  class="text-base font-extrabold uppercase tracking-wider mb-3 text-zinc-900"
                >
                  {t.cityLabel}
                </h2>
                <div class="relative">
                  <select
                    id="city-select"
                    class="w-full bg-white border-2 border-zinc-400 rounded-xl px-4 py-3 text-zinc-950 font-bold text-base focus:outline-none focus:border-zinc-950 cursor-pointer appearance-none shadow-sm"
                  >
                    {
                      cityOptions.map((opt, i) => (
                        <option
                          value={opt.id}
                          data-multiplier={opt.multiplier}
                          selected={i === 0}
                        >
                          {opt.label}
                        </option>
                      ))
                    }
                  </select>
                  <div
                    class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-700"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="city-guests-item">
                <h2
                  class="text-base font-extrabold uppercase tracking-wider mb-3 text-zinc-900"
                >
                  {t.guestsLabel}
                </h2>
                <div class="guests-field">
                  <input
                    type="number"
                    id="guests"
                    min="1"
                    value="40"
                    class="bg-white border-2 border-zinc-400 rounded-xl px-4 py-3 text-zinc-900 font-extrabold text-base focus:outline-none focus:border-zinc-950 w-full"
                  />
                </div>
              </div>
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.tentLabel}
            </h2>
            <div class="swatches">
              {
                tentOptions.map((opt, i) => (
                  <label
                    class="swatch border border-zinc-200"
                    data-price={opt.price}
                    data-w={opt.width}
                    data-h={opt.height}
                  >
                    <input
                      type="radio"
                      name="tent"
                      value={opt.id}
                      checked={i === 0}
                    />
                    <span class="swatch__label font-bold">{opt.label}</span>
                    <span class="swatch__note">{opt.note}</span>
                    <span class="swatch__price">
                      +{(opt.price ?? 0).toLocaleString("en-US")} $
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.cateringLabel}
            </h2>
            <div class="swatches">
              {
                cateringOptions.map((opt, i) => (
