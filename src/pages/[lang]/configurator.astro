                    <span class="swatch__note">{opt.note}</span>
                    <span class="swatch__price">
                      {opt.pricePerGuest > 0
                        ? `${(opt.pricePerGuest ?? 0).toLocaleString("en-US")} $ / ${t.guestsUnit}`
                        : "—"}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.decorLabel}
            </h2>
            <div class="swatches">
              {
                decorOptions.map((opt, i) => (
                  <label
                    class="swatch border border-zinc-200"
                    data-price={opt.price}
