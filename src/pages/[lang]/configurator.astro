};

const tentOptions =
  tentOptionsMap[lang as keyof typeof tentOptionsMap] || tentOptionsMap.ru;
const cateringOptions =
  cateringOptionsMap[lang as keyof typeof cateringOptionsMap] ||
  cateringOptionsMap.ru;
const decorOptions =
  decorOptionsMap[lang as keyof typeof decorOptionsMap] || decorOptionsMap.ru;
const entertainmentOptions =
  entertainmentOptionsMap[lang as keyof typeof entertainmentOptionsMap] ||
