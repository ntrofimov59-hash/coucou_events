      label: "Трансфер гостей (Микроавтобусы)",
      note: "",
      price: transferBase * 2,
    },
  ],
};

const biotoiletOptionsMap = {
  ru: [
    { id: "bio-none", label: "Не нужно", note: "", price: 0 },
    {
      id: "bio-standard",
      label: "Стандарт-модули",
      note: "",
      price: bioBase * 2,
    },
    {
      id: "bio-premium",
      label: "Премиум-комплекс",
      note: "VIP модули",
      price: bioBase * 3,
    },
  ],
  eng: [
    { id: "bio-none", label: "Not needed", note: "", price: 0 },
    {
      id: "bio-standard",
      label: "Standard modules",
      note: "",
      price: bioBase * 2,
    },
    {
      id: "bio-premium",
      label: "Premium complex",
      note: "VIP modules",
      price: bioBase * 3,
    },
  ],
  esp: [
    { id: "bio-none", label: "No necesario", note: "", price: 0 },
    {
      id: "bio-standard",
      label: "Módulos estándar",
      note: "",
      price: bioBase * 2,
    },
    {
      id: "bio-premium",
      label: "Complejo premium",
      note: "Módulos VIP",
      price: bioBase * 3,
    },
  ],
  arm: [
    { id: "bio-none", label: "Не нужно", note: "", price: 0 },
    {
      id: "bio-standard",
      label: "Стандарт-модули",
      note: "",
      price: bioBase * 2,
    },
    {
      id: "bio-premium",
      label: "Премиум-комплекс",
