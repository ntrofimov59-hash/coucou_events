                    </span>
                    <span class="swatch__note">{opt.note}</span>
                    <span class="swatch__price">
                      {opt.price > 0
                        ? `+${(opt.price ?? 0).toLocaleString("en-US")} $`
                        : "—"}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.entertainmentLabel}
            </h2>
            <div class="swatches">
              {
                entertainmentOptions.map((opt, i) => (
                  <label
                    class="swatch border border-zinc-200"
                    data-price={opt.price}
                  >
                    <input
                      type="radio"
                      name="entertainment"
                      value={opt.id}
                      checked={i === 0}
                    />
                    <span class="swatch__label font-bold">{opt.label}</span>
                    <span class="swatch__price">
                      {opt.price > 0
                        ? `+${(opt.price ?? 0).toLocaleString("en-US")} $`
                        : "—"}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.photoLabel}
            </h2>
            <div class="swatches">
              {
                photoOptions.map((opt, i) => (
                  <label
                    class="swatch border border-zinc-200"
                    data-price={opt.price}
                  >
                    <input
                      type="radio"
                      name="photo"
                      value={opt.id}
                      checked={i === 0}
                    />
                    <span class="swatch__label font-bold">{opt.label}</span>
                    <span class="swatch__price">
                      {opt.price > 0
                        ? `+${(opt.price ?? 0).toLocaleString("en-US")} $`
                        : "—"}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.transferLabel}
            </h2>
            <div class="swatches">
              {
                transferOptions.map((opt, i) => (
                  <label
                    class="swatch border border-zinc-200"
                    data-price={opt.price}
                  >
                    <input
                      type="radio"
                      name="transfer"
                      value={opt.id}
                      checked={i === 0}
                    />
                    <span class="swatch__label font-bold">{opt.label}</span>
                    <span class="swatch__price">
                      {opt.price > 0
                        ? `+${(opt.price ?? 0).toLocaleString("en-US")} $`
                        : "—"}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <h2
              class="text-base font-extrabold uppercase tracking-wider mb-4 text-zinc-900"
            >
              {t.bioLabel}
            </h2>
            <div class="swatches">
              {
                biotoiletOptions.map((opt, i) => (
                  <label
                    class="swatch border border-zinc-200"
                    data-price={opt.price}
                  >
                    <input
                      type="radio"
                      name="bio"
                      value={opt.id}
                      checked={i === 0}
                    />
                    <span class="swatch__label font-bold">{opt.label}</span>
                    <span class="swatch__note">{opt.note}</span>
                    <span class="swatch__price">
                      {opt.price > 0
                        ? `+${(opt.price ?? 0).toLocaleString("en-US")} $`
                        : "—"}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>

          <div
            class="option-group p-4 bg-white border-2 border-zinc-300 rounded-2xl shadow-sm"
          >
            <label
              class="swatch border border-zinc-200 flex-row items-center justify-between cursor-pointer"
              data-price={lightingPriceUsd}
            >
              <div class="flex flex-col">
                <span class="swatch__label font-bold">{t.lightingLabel}</span>
                <span class="swatch__note">{t.lightingNote}</span>
              </div>
              <div class="flex items-center gap-4">
                <span class="swatch__price text-zinc-900 font-bold"
                  >+{lightingPriceUsd} $</span
                >
                <input
                  type="checkbox"
                  id="lighting"
                  class="w-4 h-4 accent-zinc-900"
                />
              </div>
            </label>
          </div>
        </div>

        <aside class="summary-col">
          <div
            class="bg-white p-4 rounded-2xl border-2 border-zinc-300 shadow-sm overflow-hidden"
          >
            <p
              class="text-xs text-zinc-700 uppercase tracking-wider mb-4 font-extrabold"
            >
              {t.blueprintTitle}
            </p>
            <div
              class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-white border border-zinc-200 flex items-center justify-center"
            >
              <div
                class="absolute inset-0 opacity-[0.03] pointer-events-none"
                style="background-size: 16px 16px; background-image: linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px);"
              >
              </div>
              <svg
                id="blueprint-svg"
                viewBox="0 0 300 220"
                class="w-full h-full transition-all duration-300"
              >
                <rect
                  x="20"
                  y="20"
                  width="260"
                  height="180"
                  fill="#fafafa"
                  stroke="#e4e4e7"
                  stroke-dasharray="4,4"
                  rx="8"></rect>
                <rect
                  id="bp-tent"
                  x="60"
                  y="50"
                  width="180"
                  height="120"
                  rx="6"
                  fill="#ffffff"
                  stroke="#18181b"
                  stroke-width="2"
                  class="transition-all duration-500"></rect>
                <rect
                  id="bp-lighting"
                  x="56"
                  y="46"
                  width="188"
                  height="128"
                  rx="8"
                  fill="none"
                  stroke="#eab308"
                  stroke-width="1.5"
                  stroke-dasharray="6,4"
                  class="transition-all duration-300 opacity-0"></rect>
                <g id="bp-stage" class="transition-opacity duration-300">
                  <rect
                    x="68"
                    y="58"
                    width="35"
                    height="20"
                    fill="#f4f4f5"
                    stroke="#a1a1aa"
                    rx="2"></rect>
                  <text
                    x="85"
                    y="71"
                    font-size="8"
                    fill="#71717a"
                    text-anchor="middle"
                    font-family="monospace">STAGE</text
                  >
                </g>
                <g id="bp-tables"></g>
              </svg>
              <div
                class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[10px] text-zinc-700 font-mono bg-white/90 border border-zinc-200 px-2 py-1 rounded font-extrabold"
              >
                <span>{t.blueprintScale}</span>
                <span id="bp-legend-text">M</span>
              </div>
            </div>
            <p
              class="text-[11px] text-zinc-600 mt-2 text-center font-mono font-bold"
            >
              {t.blueprintNote}
            </p>
          </div>

          <div
            class="bg-white p-4 rounded-2xl border-2 border-zinc-300 shadow-sm"
          >
            <h2
              class="text-sm uppercase tracking-wider font-extrabold text-zinc-900 mb-4"
            >
              {t.summaryTitle}
            </h2>
            <ul
              class="summary-list text-xs space-y-3 mb-6 divide-y divide-zinc-200/60"
              id="summary-list"
            >
            </ul>
            <div
              class="summary-total pt-4 border-t border-zinc-200 flex justify-between items-baseline mb-5"
            >
              <span class="text-zinc-700 text-xs font-bold">{t.totalLabel}</span
              >
              <span
                id="summary-total"
                class="text-2xl font-serif text-zinc-950 font-extrabold"
                >0 $</span
              >
            </div>
            <a
              href={`${prefix}/booking`}
              class="btn block text-center bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-bold py-3 px-4 rounded-xl transition-colors duration-150"
              id="summary-cta"
            >
              {t.ctaText}
            </a>
          </div>
        </aside>
      </div>
    </div>

    <!-- Плавающая панель с итогом — только для мобильных, где sticky-колонка не активна (см. .configurator-grid, <960px раскладка column) -->
    <div id="floating-summary" class="floating-summary">
      <div class="floating-summary__inner">
        <div class="floating-summary__price">
          <span class="floating-summary__label">{t.totalLabel}</span>
          <span id="floating-total" class="floating-summary__value">0 $</span>
        </div>
        <a
          href={`${prefix}/booking`}
          id="floating-cta"
          class="floating-summary__cta"
        >
          {t.ctaText}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .configurator-grid {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  @media (min-width: 960px) {
    .configurator-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      align-items: start;
      gap: 2rem;
    }
  }

  /* Город + гости всегда 1+1 (бок о бок) */
  .city-guests-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    align-items: end;
  }
  .city-guests-item {
    min-width: 0;
  }
  .city-guests-item h2 {
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }

  /* Сетка опций всегда 2 колонки, компактная */
  .swatches {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .option-group h2 {
    font-size: 0.8rem !important;
    margin-bottom: 0.6rem !important;
    letter-spacing: 0.05em;
  }
  .swatch {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.85rem;
    border-radius: 10px;
    background: #ffffff;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }
  .swatch:hover {
    border-color: #18181b;
    background: #fafafa;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.04);
  }
  .swatch input[type="radio"] {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    accent-color: #18181b;
    width: 14px;
    height: 14px;
  }
  .swatch:has(input:checked) {
    border-color: #18181b;
    background: #ffffff;
    box-shadow:
      0 0 0 1px #18181b inset,
      0 3px 10px rgba(0, 0, 0, 0.04);
  }
  .swatch__label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #18181b;
    padding-right: 1.25rem;
    line-height: 1.25;
  }
  .swatch__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .swatch__note {
    font-size: 0.7rem;
    color: #71717a;
    line-height: 1.3;
  }
  .swatch__price {
    font-size: 0.75rem;
    color: #18181b;
    font-weight: 700;
    margin-top: 0.15rem;
  }

  /*
    Sticky sidebar — едет вместе со страницей вниз и вверх.
    Никакого overflow/max-height здесь быть не должно: они превращают
    блок в собственный внутренний скролл-контейнер вместо того, чтобы
    он просто "прилипал" к вьюпорту. sticky сам естественно перестаёт
    липнуть, когда доезжает до конца родительской grid-колонки — то
    есть плавно "подъезжает" и останавливается под последней опцией,
    как только колонка с опциями заканчивается.
  */
  .summary-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: -webkit-sticky;
    position: sticky;
    top: 1rem;
    align-self: start;
    z-index: 20;
  }

  /* Плавающая панель внизу (мобильные, где grid превращается в колонку) */
  .floating-summary {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid #e4e4e7;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    padding: 0.75rem 1rem;
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  .floating-summary__inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .floating-summary__price {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .floating-summary__label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #71717a;
  }
  .floating-summary__value {
    font-size: 1.35rem;
    font-weight: 800;
    font-family: serif;
    color: #18181b;
    line-height: 1.1;
  }
  .floating-summary__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #18181b;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .floating-summary__cta:hover {
    background: #27272a;
  }

  /* На десктопе right-колонка уже sticky и всегда видна — дублирующая
     нижняя панель не нужна, скрываем её начиная с той же точки, где
     включается grid-раскладка (960px). */
  @media (min-width: 960px) {
    .floating-summary {
      display: none;
    }
    .configurator-page {
      padding-bottom: 4rem;
    }
  }

  /* Отступ снизу у страницы на мобильных, чтобы контент не прятался под панелью */
  .configurator-page {
    padding-bottom: 5.5rem;
  }
</style>

<script lang="ts" define:vars={{ translations: t, currentLang: lang }}>
  const guestsInput = document.getElementById("guests");
  const citySelect = document.getElementById("city-select");
  const summaryList = document.getElementById("summary-list");
  const summaryTotal = document.getElementById("summary-total");
  const summaryCta = document.getElementById("summary-cta");
  const floatingTotal = document.getElementById("floating-total");
  const floatingCta = document.getElementById("floating-cta");
  const lighting = document.getElementById("lighting");

  const bpTent = document.getElementById("bp-tent");
  const bpLighting = document.getElementById("bp-lighting");
  const bpStage = document.getElementById("bp-stage");
  const bpTables = document.getElementById("bp-tables");
  const legendText = document.getElementById("bp-legend-text");

  const t = translations;

  function formatPriceUSD(n) {
    return `$${Math.round(n || 0).toLocaleString("en-US")}`;
  }

  function checkedIn(name) {
    return document.querySelector(`input[name="${name}"]:checked`);
  }

  function updateBlueprint() {
    const tent = checkedIn("tent");
    let currentW = 180;
    let currentH = 120;

    if (tent && bpTent && legendText) {
      const wrap = tent.closest(".swatch");
      if (wrap) {
        currentW = Number(wrap.dataset.w) || 180;
        currentH = Number(wrap.dataset.h) || 120;
      }

      const nextX = 150 - currentW / 2;
      const nextY = 110 - currentH / 2;

      bpTent.setAttribute("x", String(nextX));
      bpTent.setAttribute("y", String(nextY));
      bpTent.setAttribute("width", String(currentW));
      bpTent.setAttribute("height", String(currentH));

      if (bpLighting) {
        bpLighting.setAttribute("x", String(nextX - 4));
        bpLighting.setAttribute("y", String(nextY - 4));
        bpLighting.setAttribute("width", String(currentW + 8));
        bpLighting.setAttribute("height", String(currentH + 8));
      }

      const labelEl = wrap?.querySelector(".swatch__label");
      legendText.textContent = labelEl?.textContent?.trim() || t.tentFallback;
    }

    const decor = checkedIn("decor");
    if (decor && bpTent) {
      const wrap = decor.closest(".swatch");
      const hexColor = wrap?.dataset.color || "#18181b";
      if (decor.value === "decor-none") {
        bpTent.setAttribute("fill", "#ffffff");
        bpTent.setAttribute("stroke", "#18181b");
      } else {
        bpTent.setAttribute("fill", `${hexColor}08`);
        bpTent.setAttribute("stroke", hexColor);
      }
    }

    if (bpLighting) {
      bpLighting.style.opacity = lighting?.checked ? "1" : "0";
    }

    const ent = checkedIn("entertainment");
    if (bpStage) {
      bpStage.style.opacity = ent && ent.value !== "ent-none" ? "1" : "0";
    }

    const guests = Number(guestsInput?.value) || 0;
    const catering = checkedIn("catering");
    const hasTables = catering && catering.value !== "catering-none";

    if (bpTables) {
      bpTables.innerHTML = "";
      if (hasTables && guests > 0) {
        const tableCount = Math.min(12, Math.max(1, Math.ceil(guests / 8)));
        const tentX = 150 - currentW / 2;
        const tentY = 110 - currentH / 2;

        for (let i = 0; i < tableCount; i++) {
          const cols = currentW > 200 ? 4 : 3;
          const col = i % cols;
          const row = Math.floor(i / cols);

          const paddingX = currentW / (cols + 1);
          const paddingY = currentH / (Math.ceil(tableCount / cols) + 1);

          const posX = tentX + paddingX * (col + 1);
          const posY = tentY + paddingY * (row + 1) + 8;

          if (posX < tentX + currentW - 15 && posY < tentY + currentH - 15) {
            const tableCircle = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "circle",
            );
            tableCircle.setAttribute("cx", String(posX));
            tableCircle.setAttribute("cy", String(posY));
            tableCircle.setAttribute("r", "6");
            tableCircle.setAttribute("fill", "none");
            tableCircle.setAttribute("stroke", "#71717a");
            tableCircle.setAttribute("stroke-width", "1");
            bpTables.appendChild(tableCircle);

            for (let s = 0; s < 6; s++) {
              const angle = (s * Math.PI) / 3;
              const chairX = posX + 9 * Math.cos(angle);
              const chairY = posY + 9 * Math.sin(angle);
              const chair = document.createElementNS(
                "http://www.w3.org/2000/svg",
                "circle",
              );
              chair.setAttribute("cx", String(chairX));
              chair.setAttribute("cy", String(chairY));
              chair.setAttribute("r", "1.5");
              chair.setAttribute("fill", "#a1a1aa");
              bpTables.appendChild(chair);
            }
          }
        }
      }
    }
  }

  function recalculate() {
    if (!summaryList || !summaryTotal) return;

    let subtotal = 0;
    const items = [];

    // Получаем коэффициент выбранного города
    let multiplier = 1.0;
    let cityName = "";
    if (citySelect) {
      const selectedOption = citySelect.options[citySelect.selectedIndex];
      multiplier = Number(selectedOption?.dataset.multiplier) || 1.0;
      cityName = selectedOption?.text.trim() || "";

      items.unshift({
        label: `${t.cityнь} ${cityName}`,
        isCity: true,
      });
    }

    function addRadioPrice(name, fallbackLabel) {
      const el = checkedIn(name);
      if (!el) return;
      const wrap = el.closest(".swatch");
      const basePrice = Number(wrap?.dataset.price) || 0;
      if (basePrice > 0) {
        // Применяем рыночный коэффициент города прямо к отдельным компонентам
        const price = Math.round(basePrice * multiplier);
        const label =
          wrap?.querySelector(".swatch__label")?.textContent?.trim() ||
          fallbackLabel;
        items.push({ label, price });
        subtotal += price;
      }
    }

    addRadioPrice("tent", t.tentFallback);

    const catering = checkedIn("catering");
    const guests = Number(guestsInput?.value) || 0;
    if (catering) {
      const wrap = catering.closest(".swatch");
      const basePerGuest = Number(wrap?.dataset.pricePerGuest) || 0;
      // Применяем коэффициент города и умножаем на количество гостей
      const price = Math.round(basePerGuest * multiplier * guests);
      if (price > 0) {
        const label =
          wrap?.querySelector(".swatch__label")?.textContent?.trim() || "";
        items.push({
          label: `${t.cateringPrefix} ${label} (${guests} ${t.guestsUnit})`,
          price,
        });
        subtotal += price;
      }
    }

    addRadioPrice("decor", t.decorFallback);
    addRadioPrice("entertainment", t.entertainmentFallback);
    addRadioPrice("photo", t.photoFallback);
    addRadioPrice("transfer", t.transferFallback);
    addRadioPrice("bio", t.bioFallback);

    if (lighting?.checked) {
      const wrap = lighting.closest(".swatch");
      const basePrice = Number(wrap?.dataset.price) || 0;
      const price = Math.round(basePrice * multiplier);
      items.push({ label: t.lightingLabelShort, price });
      subtotal += price;
    }

    // Итоговая сумма (базовые сметные элементы уже с учетом города, поэтому subtotal равен total)
    const total = subtotal;

    // Округление шагом до 50 USD согласно логике pricingData
    const step = total < 100 ? 5 : 50;
    const finalTotal = Math.ceil(total / step) * step;

    summaryList.innerHTML = items
      .map((i) => {
        if (i.isCity) {
          return `<li class="flex justify-between items-center pt-2 text-zinc-700 border-zinc-100 font-medium">
            <span class="font-normal">${i.label}</span>
            <span class="font-bold text-zinc-900">—</span>
          </li>`;
        }
        return `<li class="flex justify-between items-center pt-2 text-zinc-700 border-zinc-100 font-medium">
            <span class="font-normal">${i.label}</span>
            <span class="font-bold text-zinc-900">${formatPriceUSD(i.price)}</span>
          </li>`;
      })
      .join("");

    const totalText = formatPriceUSD(finalTotal);
    summaryTotal.textContent = totalText;
    if (floatingTotal) floatingTotal.textContent = totalText;

    const selectedTent =
      checkedIn("tent")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";
    const selectedCatering =
      checkedIn("catering")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";
    const selectedDecor =
      checkedIn("decor")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";
    const selectedEnt =
      checkedIn("entertainment")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";
    const selectedPhoto =
      checkedIn("photo")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";
    const selectedTransfer =
      checkedIn("transfer")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";
    const selectedBio =
      checkedIn("bio")
        ?.closest(".swatch")
        ?.querySelector(".swatch__label")
        ?.textContent?.trim() || "";

    const configParams = new URLSearchParams({
      service: t.serviceName,
      guests: guestsInput?.value || "0",
      location: cityName,
      estimate: totalText,
      options: [
        selectedTent,
        selectedCatering ? `${t.optionCatering}: ${selectedCatering}` : "",
        selectedDecor ? `${t.optionDecor}: ${selectedDecor}` : "",
        selectedEnt ? `${t.optionMusic}: ${selectedEnt}` : "",
        selectedPhoto ? `${t.optionPhoto}: ${selectedPhoto}` : "",
        selectedTransfer ? `${t.optionTransfer}: ${selectedTransfer}` : "",
        selectedBio ? `${t.optionBio}: ${selectedBio}` : "",
        lighting?.checked ? t.optionLighting : "",
      ]
        .filter(Boolean)
        .join(", "),
    });

    const langPrefix =
      window.location.pathname.match(/^\/(ru|eng|esp|arm)/)?.[0] || "/ru";
    const bookingHref = `${langPrefix}/booking?${configParams.toString()}`;

    if (summaryCta) summaryCta.href = bookingHref;
    if (floatingCta) floatingCta.href = bookingHref;

    updateBlueprint();
  }

  document.querySelectorAll(".options input").forEach((input) => {
    input.addEventListener("change", recalculate);
  });
  citySelect?.addEventListener("change", recalculate);
  guestsInput?.addEventListener("input", recalculate);

  recalculate();
</script>