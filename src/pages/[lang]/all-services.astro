---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "ru" } },
    { params: { lang: "eng" } },
    { params: { lang: "esp" } },
    { params: { lang: "arm" } },
  ];
}

const { lang = "ru" } = Astro.params;
const prefix = `/${lang}`;

const uiTranslations = {
  ru: {
    seoTitle: "Услуги — Организация мероприятий под ключ | Coucou",
    seoDescription:
