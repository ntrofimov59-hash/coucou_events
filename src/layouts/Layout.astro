---
import SeoHead from '@/components/SeoHead.astro';
import Header from "@/components/Header/Header.astro";
import { Footer } from "@/components/Footer";
import FloatingActions from "@/components/ui/FloatingActions.astro";
import Analytics from "@/components/ui/Analytics.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: string;
  lang?: string;
  currentPath?: string;
  service?: {
    name: string;
    description: string;
    serviceType?: string;
    image?: string;
    price?: string;
    priceCurrency?: string;
  };
}

const { 
  title, 
  description, 
  image, 
  locale = 'ru',
  lang,
  currentPath,
  service 
} = Astro.props;

const currentLocale = lang || locale;
const pagePath = currentPath || Astro.url.pathname;
---
<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoHead 
      title={title} 
      description={description} 
      image={image} 
      locale={currentLocale}
      service={service}
    />
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">
    <Header currentPath={pagePath} lang={currentLocale} />
    <slot />
    <Footer currentPath={pagePath} lang={currentLocale} />
    <FloatingActions />
    <Analytics />
  </body>
</html>
