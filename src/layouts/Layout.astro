---
import SeoHead from '@/components/SeoHead.astro';
import Header from "@/components/Header/Header.astro";
import { Footer } from "@/components/Footer";
import FloatingActions from "@/components/ui/FloatingActions.astro";
import Analytics from "@/components/ui/Analytics.astro";
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, CONTACT } from "@/config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: string;
  lang?: string;
  currentPath?: string;
  service?: {
    name: string;
    description: string;
    serviceType?: string;
    image?: string;
    price?: string;
    priceCurrency?: string;
  };
}

const { 
  title, 
  description, 
  image, 
  locale = 'ru',
  lang,
  currentPath,
  service 
} = Astro.props;

const currentLocale = lang || locale;
const pagePath = currentPath || Astro.url.pathname;

// Organization JSON-LD — на каждой странице сайта.
// Это то, за что в первую очередь цепляются ИИ-поисковики (ChatGPT,
// Perplexity, Google AI Overviews) и Knowledge Graph при заходе на домен:
// кто это, где физически находится, как связаться, какие есть
// официальные профили. Дублируется на всех страницах намеренно —
// расход ничтожный, а гарантия, что боты увидят это с любого входа,
// того стоит.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE_URL}/#organization`,
  name: SITE_NAME,
  legalName: `${SITE_NAME} Events`,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "24 Vagharsh Vagharshyan St",
    addressLocality: "Yerevan",
    postalCode: "0012",
    addressCountry: "AM",
  },
  areaServed: {
    "@type": "Country",
    name: "Worldwide",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "09:00",
    closes: "21:00",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: CONTACT.phone,
    contactType: "customer service",
    email: CONTACT.email,
    availableLanguage: ["Russian", "English", "Spanish", "Armenian"],
  },
  sameAs: [
    CONTACT.instagram,
    CONTACT.facebook,
    CONTACT.telegram,
    CONTACT.whatsappHref,
  ].filter(Boolean),
};
---
<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoHead 
      title={title} 
      description={description} 
      image={image} 
      locale={currentLocale}
      service={service}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
    />
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">
    <Header currentPath={pagePath} lang={currentLocale} />
    <slot />
    <Footer currentPath={pagePath} lang={currentLocale} />
    <FloatingActions />
    <Analytics />
  </body>
</html>
